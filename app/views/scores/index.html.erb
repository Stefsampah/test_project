<div class="min-h-screen bg-black py-6">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-6">
      <h1 class="text-3xl font-extrabold text-white tracking-wide">Classement</h1>
    </div>

    <% top_three = @total_scores.first(3) %>
    <% first = top_three[0] %>
    <% second = top_three[1] %>
    <% third = top_three[2] %>

    <%# On pré-calcule le nombre de playlists jouées par user pour éviter les incohérences d'affichage %>
    <% playlist_count_by_user = (@users || []).each_with_object({}) do |u, h|
         h[u.id] = u.scores.map(&:playlist_id).uniq.count
       end %>

    <div class="p-3 mb-5">
      <div class="flex items-end justify-center gap-6">
        <% [third, first, second].each_with_index do |entry, idx| %>
          <% if entry.present? %>
            <% u = @users_by_id[entry[:user_id]] %>
            <% next unless u %>
            <% size = idx == 1 ? "w-20 h-20" : "w-16 h-16" %>
            <% rank_text = idx == 1 ? "1st" : (idx == 2 ? "2nd" : "3rd") %>
            <div class="text-center">
              <div class="<%= size %> rounded-full overflow-hidden mx-auto bg-black/30 shadow-lg">
                <% if u.avatar.attached? %>
                  <%= image_tag u.avatar, class: "w-full h-full object-cover" %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-white font-bold">
                    <%= u.email.first.upcase %>
                  </div>
                <% end %>
              </div>
              <div class="mt-2 text-[11px] text-white font-bold"><%= rank_text %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="rounded-3xl overflow-hidden shadow-xl" style="background: linear-gradient(180deg, #7e22ce 0%, #2563eb 100%);">
      <div class="p-3 sm:p-5 overflow-x-hidden">
        <% if @total_scores.present? %>
          <table class="w-full table-fixed text-white text-[11px] sm:text-sm">
            <colgroup>
              <col style="width: 14%;">
              <col style="width: 44%;">
              <col style="width: 20%;">
              <col style="width: 22%;">
            </colgroup>
            <thead>
              <tr class="border-b border-white/20 text-[10px] sm:text-xs font-extrabold uppercase tracking-wide">
                <th class="text-left py-2 pr-2 sm:pr-4 whitespace-nowrap">
                  <span class="sm:hidden">Rk</span>
                  <span class="hidden sm:inline"><%= t('scores.columns.ranks', default: 'Ranks') %></span>
                </th>
                <th class="text-left py-2 px-1 sm:px-3 whitespace-nowrap"><%= t('scores.columns.player', default: 'Player') %></th>
                <th class="text-right py-2 px-1 sm:px-3 whitespace-nowrap">
                  <span class="sm:hidden">Pt</span>
                  <span class="hidden sm:inline"><%= t('scores.columns.point', default: 'Point') %></span>
                </th>
                <th class="text-right py-2 pl-2 sm:pl-4 whitespace-nowrap">
                  <span class="sm:hidden">Pl</span>
                  <span class="hidden sm:inline"><%= t('scores.columns.playlist', default: 'Playlist') %></span>
                </th>
              </tr>
            </thead>
            <tbody>
              <% @total_scores.each_with_index do |score, index| %>
                <% user = @users_by_id[score[:user_id]] %>
                <% next unless user %>
                <% rank = index + 1 %>
                <% rank_label = rank == 1 ? "1st" : (rank == 2 ? "2nd" : (rank == 3 ? "3rd" : "#{rank}th")) %>
                <% is_current_user = user_signed_in? && user.id == current_user.id %>
                <tr class="border-b border-white/15 <%= is_current_user ? 'bg-black/20' : '' %>">
                  <td class="py-3 pr-2 sm:pr-4 text-[11px] sm:text-sm font-semibold whitespace-nowrap"><%= rank_label %></td>
                  <td class="py-3 px-1 sm:px-3">
                    <div class="flex items-center gap-2 min-w-0">
                      <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-full overflow-hidden bg-black/30 flex-shrink-0">
                        <% if user.avatar.attached? %>
                          <%= image_tag user.avatar, class: "w-full h-full object-cover" %>
                        <% else %>
                          <div class="w-full h-full flex items-center justify-center text-white text-xs font-bold">
                            <%= user.email.first.upcase %>
                          </div>
                        <% end %>
                      </div>
                      <div class="truncate text-[11px] sm:text-sm font-medium">
                        <%= user.email.split('@').first %>
                        <% if is_current_user %>
                          <span class="text-[11px] text-purple-200">(toi)</span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-1 sm:px-3 text-right text-amber-200 text-[11px] sm:text-sm font-extrabold whitespace-nowrap"><%= score[:points].to_i %></td>
                  <td class="py-3 pl-2 sm:pl-4 text-right text-[11px] sm:text-sm font-semibold whitespace-nowrap"><%= playlist_count_by_user[user.id] || 0 %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-2 py-6 text-center text-white/80 text-sm">
            Aucun score disponible pour le moment.
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
