<%
  # Expected locals:
  # - variant: :live | :physique
  # - season_points: integer
  # - target_points: integer (3000 / 6000)
  # - video_key: String (ex: "concerts/concert_live.mp4")
  # - image_key: String (ex: "concerts/concert_live.png")
  # - tag_label: String ("Live" / "Physique")
  # - percent: integer (0..100)
  # - use_video: boolean (optional, default false)

  is_unlocked = (season_points.to_i >= target_points.to_i)
  remaining = [target_points.to_i - season_points.to_i, 0].max

  bar_bg = "bg-white"
  title_text = variant.to_sym == :physique ? "Concert physique" : "Concert live"
  unlocked_text = variant.to_sym == :physique ? "Eligible au tirage place physique" : "Lien concert debloque"
  target_hint = variant.to_sym == :physique ? "Objectif 6 000 pts" : "Objectif 3 000 pts"
  tag_style = variant.to_sym == :physique ? "bg-black text-amber-200" : "bg-white text-black"
  media_overlay_style =
    if variant.to_sym == :physique
      "background: linear-gradient(180deg, #f59e0b 0%, #6b21a8 60%, #111827 100%); opacity: 0.50;"
    else
      "background: linear-gradient(180deg, #a855f7 0%, #6b21a8 55%, #111827 100%); opacity: 0.50;"
    end

  use_video = local_assigns.fetch(:use_video, false)
%>

<div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-b from-[#6b21a8]/85 to-[#1d4ed8]/85 text-white shadow-2xl">
  <div class="p-4">
    <div class="relative overflow-hidden rounded-2xl" style="height: 20rem;">
      <% if use_video %>
        <% begin %>
          <%= video_tag video_key,
                        autoplay: true,
                        loop: true,
                        muted: true,
                        playsinline: true,
                        class: "w-full h-full object-cover concert-media-pulse" %>
        <% rescue Sprockets::Rails::Helper::AssetNotFound %>
          <% if image_key.present? %>
            <%= image_tag image_key,
                          alt: tag_label,
                          class: "w-full h-full object-cover concert-media-pulse" %>
          <% else %>
            <div class="w-full h-full concert-media-pulse"
                 style="<%= variant.to_sym == :physique ? 'background: radial-gradient(circle at 70% 10%, #fdba74 0%, #f59e0b 32%, #6b21a8 62%, #111827 88%);' : 'background: radial-gradient(circle at 25% 20%, #c084fc 0%, #6b21a8 38%, #111827 75%);' %>">
            </div>
          <% end %>
        <% end %>
      <% elsif image_key.present? %>
        <%= image_tag image_key,
                      alt: tag_label,
                      class: "w-full h-full object-cover concert-media-pulse" %>
      <% else %>
        <div class="w-full h-full concert-media-pulse"
             style="<%= variant.to_sym == :physique ? 'background: radial-gradient(circle at 70% 10%, #fdba74 0%, #f59e0b 32%, #6b21a8 62%, #111827 88%);' : 'background: radial-gradient(circle at 25% 20%, #c084fc 0%, #6b21a8 38%, #111827 75%);' %>">
        </div>
      <% end %>

      <!-- Foreground overlay @ 50% to keep visual visible -->
      <div class="pointer-events-none absolute inset-0" style="<%= media_overlay_style %>"></div>

      <div class="absolute top-3 right-3">
        <span class="rounded-full px-3 py-1 text-xs font-bold <%= tag_style %>">
          <%= tag_label.upcase %>
        </span>
      </div>

      <% if is_unlocked %>
        <div class="absolute left-3 top-3 rounded-md border-2 border-white bg-emerald-500/90 px-2.5 py-1 text-[10px] font-black tracking-wide text-white shadow-lg">
          ELIGIBLE
        </div>
      <% end %>
    </div>

    <h2 class="mt-4 text-2xl font-black <%= variant.to_sym == :physique ? 'text-amber-100' : 'text-white' %>">
      <%= title_text %>
    </h2>
    <p class="mt-1 text-sm <%= variant.to_sym == :physique ? 'text-amber-100/90' : 'text-white/90' %>">
      <%= target_hint %>
    </p>

    <div class="mt-4 flex items-center justify-between text-xs font-semibold text-white/90">
      <span><%= season_points.to_i %> / <%= target_points.to_i %> pts</span>
      <span><%= percent.to_i %>%</span>
    </div>
    <div class="mt-2">
      <%= render "shared/progress_bar_season", percent: percent.to_i, bar_bg: bar_bg %>
    </div>

    <p class="mt-2 text-xs font-semibold text-white/90">
      <% if is_unlocked %>
        <%= unlocked_text %>
      <% else %>
        Encore <span class="text-white"><%= remaining %></span> pts
      <% end %>
    </p>
  </div>
</div>

