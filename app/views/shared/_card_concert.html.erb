<%
  # Expected locals:
  # - variant: :live | :physique
  # - season_points: integer
  # - target_points: integer (3000 / 6000)
  # - video_key: String (ex: "concerts/concert_live.mp4")
  # - image_key: String (ex: "concerts/concert_live.png")
  # - tag_label: String ("Live" / "Physique")
  # - percent: integer (0..100)
  # - use_video: boolean (optional, default false)

  is_unlocked = (season_points.to_i >= target_points.to_i)
  remaining = [target_points.to_i - season_points.to_i, 0].max

  # Barre de progression "blanche" comme demandé (accent couleur via le cadre + overlay).
  bar_bg = "bg-white"

  panel_bg =
    if variant.to_sym == :physique
      "bg-gradient-to-r from-amber-600 via-orange-500 to-amber-300"
    else
      "bg-gradient-to-r from-purple-800 via-[#6b21a8] to-fuchsia-700"
    end

  use_video = local_assigns.fetch(:use_video, false)
%>

<style>
  /* Dégradé plein écran puis "rétraction" sur interaction (hover/press doigt). */
  .concert-card {
    position: relative;
  }

  .concert-gradient-layer {
    transition: transform 240ms ease-out;
    transform-origin: bottom;
    transform: scaleY(1);
    z-index: 0;
  }

  .concert-card:hover .concert-gradient-layer,
  .concert-card:active .concert-gradient-layer {
    transform: scaleY(0.28);
  }
</style>

<div class="concert-card relative h-80 rounded-3xl overflow-hidden border border-purple-500/25 bg-black shadow-lg">
  <!-- Dégradé couvre toute la carte (puis se rétracte au hover/press) -->
  <div class="absolute inset-0 <%= panel_bg %> concert-gradient-layer"></div>

  <!-- Media frame (gros visuel ~75%) -->
  <div class="relative" style="height:240px;">
    <div class="absolute inset-0">
      <% if use_video %>
        <% begin %>
          <%= video_tag video_key,
                        autoplay: true,
                        loop: true,
                        muted: true,
                        playsinline: true,
                        class: "w-full h-full object-cover concert-media-pulse" %>
        <% rescue Sprockets::Rails::Helper::AssetNotFound %>
          <% if image_key.present? %>
            <%= image_tag image_key,
                          alt: tag_label,
                          class: "w-full h-full object-cover concert-media-pulse" %>
          <% else %>
            <div class="w-full h-full concert-media-pulse"
                 style="<%= variant.to_sym == :physique ? 'background: radial-gradient(circle at 70% 10%, #fdba74 0%, #f59e0b 32%, #6b21a8 62%, #111827 88%);' : 'background: radial-gradient(circle at 25% 20%, #c084fc 0%, #6b21a8 38%, #111827 75%);' %>">
            </div>
          <% end %>
        <% end %>
      <% elsif image_key.present? %>
        <%= image_tag image_key,
                      alt: tag_label,
                      class: "w-full h-full object-cover concert-media-pulse" %>
      <% else %>
        <div class="w-full h-full concert-media-pulse"
             style="<%= variant.to_sym == :physique ? 'background: radial-gradient(circle at 70% 10%, #fdba74 0%, #f59e0b 32%, #6b21a8 62%, #111827 88%);' : 'background: radial-gradient(circle at 25% 20%, #c084fc 0%, #6b21a8 38%, #111827 75%);' %>">
        </div>
      <% end %>
    </div>

    <!-- Tag top-right -->
    <div class="absolute top-3 right-3">
      <span class="px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wide
                   bg-white/10 border <%= variant.to_sym == :physique ? 'border-amber-400/30 text-amber-200' : 'border-purple-400/30 text-purple-200' %>">
        <%= tag_label %>
      </span>
    </div>
  </div>

  <!-- Overlay style mini-player (carte type concert) -->
  <div class="absolute bottom-0 left-0 right-0 px-4 py-3 rounded-b-3xl bg-transparent">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="text-sm font-extrabold <%= variant.to_sym == :physique ? 'text-white' : 'text-white' %> truncate">
          <%= variant.to_sym == :physique ? 'Concert physique' : 'Concert live' %>
        </div>

        <div class="mt-1 text-xs font-semibold text-white/90">
          <% if is_unlocked %>
            <%= variant.to_sym == :physique ? 'Éligible' : 'Débloqué' %> 🎉
          <% else %>
            Encore <span class="text-white"><%= remaining %></span> pts
          <% end %>
        </div>

        <div class="text-[10px] text-white/75 mt-0.5">
          Objectif <%= target_points.to_i %> pts
          <% if variant.to_sym == :physique %>
            • tirage 10
          <% end %>
        </div>
      </div>

      <!-- Play button -->
      <div class="shrink-0 flex items-center justify-center">
        <div class="w-10 h-10 rounded-full bg-white/20 border border-white/25 flex items-center justify-center">
          <svg viewBox="0 0 24 24" class="w-5 h-5 text-white" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="mt-2">
      <%= render "shared/progress_bar_season", percent: percent.to_i, bar_bg: bar_bg %>
    </div>
  </div>
</div>

