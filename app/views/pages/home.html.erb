<%
  featured_playlist = Playlist.joins(:videos)
    .where.not(videos: { youtube_id: [nil, ""] })
    .where("LENGTH(videos.youtube_id) >= 10")
    .where("videos.youtube_id NOT LIKE '-%'")
    .distinct
    .first
  featured_thumb = featured_playlist&.valid_thumbnail_id
  is_en = I18n.locale.to_s == "en"
%>

<div class="relative min-h-screen overflow-hidden bg-black text-white">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(168,85,247,0.35),transparent_45%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_10%,rgba(99,102,241,0.30),transparent_45%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/55 to-black"></div>
  </div>

  <section class="relative z-10 flex min-h-[100svh] items-center">
    <div class="mx-auto w-full max-w-md px-4 pb-10 pt-8">
      <div class="mb-7 flex justify-center">
        <%= image_tag "Logo/Copilot_20251006_162220.png", alt: "Tube'NPlay", class: "h-24 w-24 object-contain drop-shadow-2xl" %>
      </div>

      <h1 class="text-4xl leading-tight font-extrabold text-white mt-2 text-center">
        <%= is_en ? "Try your luck and win a concert ticket" : "Tente ta chance et remporte une place de concert" %>
      </h1>

      <p class="mt-3 text-center text-sm text-white/80">
        <%= is_en ? "Swipe songs, earn season points, unlock live rewards." : "Swipe les sons, gagne des points saison, debloque des rewards live." %>
      </p>

      <div class="mt-7 grid grid-cols-2 gap-3">
        <article class="overflow-hidden rounded-3xl bg-gradient-to-b from-[#6b21a8]/85 to-[#1d4ed8]/80 shadow-2xl ring-1 ring-white/10">
          <div class="relative h-44">
            <% if featured_thumb.present? %>
              <img src="https://img.youtube.com/vi/<%= featured_thumb %>/hqdefault.jpg"
                   alt=""
                   class="h-full w-full object-cover"
                   loading="lazy"
                   onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= featured_thumb %>/mqdefault.jpg';">
            <% else %>
              <div class="h-full w-full bg-[radial-gradient(circle_at_25%_20%,#c084fc_0%,#6b21a8_38%,#111827_75%)]"></div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          </div>
          <div class="p-3">
            <p class="text-xs font-black tracking-wide text-purple-200"><%= is_en ? "NO LIMIT" : "NO LIMIT" %></p>
            <p class="mt-1 line-clamp-1 text-xs text-white/80"><%= featured_playlist&.title || (is_en ? "Featured playlist" : "Playlist mise en avant") %></p>
          </div>
        </article>

        <article class="overflow-hidden rounded-3xl bg-gradient-to-b from-[#f59e0b]/90 via-[#a855f7]/80 to-[#111827] shadow-2xl ring-1 ring-white/10">
          <div class="relative h-44">
            <% begin %>
              <%= image_tag "concerts/concert_live.png", alt: "", class: "h-full w-full object-cover" %>
            <% rescue Sprockets::Rails::Helper::AssetNotFound %>
              <div class="h-full w-full bg-[radial-gradient(circle_at_70%_10%,#fdba74_0%,#f59e0b_32%,#6b21a8_62%,#111827_88%)]"></div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
          </div>
          <div class="p-3">
            <p class="text-xs font-black tracking-wide text-amber-200"><%= is_en ? "LIVE CONCERT" : "CONCERT LIVE" %></p>
            <p class="mt-1 text-xs text-white/85"><%= is_en ? "Goal 3,000 pts" : "Objectif 3 000 pts" %></p>
          </div>
        </article>
      </div>

      <div class="mt-8 flex flex-col items-center gap-3">
        <% if user_signed_in? %>
          <%= link_to playlists_path, class: "w-full max-w-xs bg-gradient-to-r from-purple-600 to-purple-700 hover:from-white hover:to-white hover:text-purple-600 text-white px-8 py-4 rounded-full text-xl font-bold text-center transition-all transform hover:scale-105 shadow-2xl" do %>
            <%= t("home.start") %>
          <% end %>
          <%= link_to journey_path, class: "w-full max-w-xs inline-flex items-center justify-center rounded-full border border-white/35 bg-white/10 px-6 py-3 text-sm font-bold text-white hover:bg-white/15 transition-all" do %>
            <%= is_en ? "See my journey" : "Voir mon parcours" %>
          <% end %>
        <% else %>
          <%= link_to new_user_registration_path, class: "w-full max-w-xs bg-gradient-to-r from-purple-600 to-purple-700 hover:from-white hover:to-white hover:text-purple-600 text-white px-8 py-4 rounded-full text-xl font-bold text-center transition-all transform hover:scale-105 shadow-2xl" do %>
            <%= t("home.start") %>
          <% end %>
          <%= link_to new_user_session_path, class: "w-full max-w-xs inline-flex items-center justify-center rounded-full border border-white/35 bg-white/10 px-6 py-3 text-sm font-bold text-white hover:bg-white/15 transition-all" do %>
            <%= t("nav.sign_in") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
</div>
