<div class="results-container min-h-screen bg-black py-6">
  <div class="max-w-4xl mx-auto px-4">
    <% game_points = @score&.points.to_i %>
    <% season_points = current_user.season_journey_points.to_i %>
    <% likes_count = @liked_videos&.size.to_i %>
    <% dislikes_count = @not_liked_videos&.size.to_i %>

    <div class="rounded-3xl overflow-hidden shadow-xl mb-5" style="background: linear-gradient(180deg, #7e22ce 0%, #2563eb 100%);">
      <div class="p-6 text-center">
        <p class="text-white/80 text-sm uppercase tracking-wide font-semibold"><%= t("games.results.end_of_game") %></p>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-1"><%= t("games.results.congrats") %></h1>
        <p class="text-white/90 text-sm mt-2"><%= @playlist.title %></p>

        <div class="mt-4 flex justify-center">
          <div class="w-20 h-20 rounded-full overflow-hidden bg-black/30 shadow-lg">
            <% if current_user&.avatar&.attached? %>
              <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-white text-2xl font-bold">
                <%= current_user.email.first.upcase %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="mt-5 grid grid-cols-3 gap-3">
          <div class="rounded-2xl bg-black/25 p-3">
            <div class="text-[11px] text-white/75 uppercase"><%= t("games.results.game_score") %></div>
            <div class="text-2xl font-extrabold text-amber-300 mt-1"><%= game_points %></div>
          </div>
          <div class="rounded-2xl bg-black/25 p-3">
            <div class="text-[11px] text-white/75 uppercase"><%= t("games.results.ranking") %></div>
            <div class="text-2xl font-extrabold text-white mt-1">#<%= @position || "-" %></div>
          </div>
          <div class="rounded-2xl bg-black/25 p-3">
            <div class="text-[11px] text-white/75 uppercase"><%= t("games.results.season_points") %></div>
            <div class="text-2xl font-extrabold text-amber-200 mt-1"><%= season_points %></div>
          </div>
        </div>

        <div class="mt-4 text-sm text-white/85">
          👍 <span class="font-semibold"><%= likes_count %></span> <%= t("games.results.likes") %> · 👎
          <span class="font-semibold"><%= dislikes_count %></span> <%= t("games.results.dislikes") %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
      <div class="rounded-3xl bg-gradient-to-b from-[#7e22ce] to-[#5b21b6] p-4">
        <div class="text-white font-bold mb-3"><%= t("games.results.songs_liked") %></div>
        <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
          <% if @liked_videos.present? %>
            <% @liked_videos.each do |video| %>
              <div class="rounded-xl bg-black/25 px-3 py-2 text-sm text-white/95 truncate">
                <%= video.title %>
              </div>
            <% end %>
          <% else %>
            <div class="rounded-xl bg-black/25 px-3 py-3 text-sm text-white/70"><%= t("games.results.no_likes") %></div>
          <% end %>
        </div>
      </div>

      <div class="rounded-3xl bg-gradient-to-b from-[#312e81] to-[#1e1b4b] p-4">
        <div class="text-white font-bold mb-3"><%= t("games.results.songs_disliked") %></div>
        <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
          <% if @not_liked_videos.present? %>
            <% @not_liked_videos.each do |video| %>
              <div class="rounded-xl bg-black/25 px-3 py-2 text-sm text-white/95 truncate">
                <%= video.title %>
              </div>
            <% end %>
          <% else %>
            <div class="rounded-xl bg-black/25 px-3 py-3 text-sm text-white/70"><%= t("games.results.no_dislikes") %></div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      <a href="<%= playlists_path %>"
         class="flex-1 inline-flex items-center justify-center rounded-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 transition-all">
        🎵 <%= t("games.results.new_playlist") %>
      </a>
      <a href="<%= journey_path %>"
         class="flex-1 inline-flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 border border-purple-500/50 text-white font-semibold py-3 transition-all">
        🎯 <%= t("games.results.view_journey") %>
      </a>
      <a href="<%= scores_path %>"
         class="flex-1 inline-flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 border border-purple-500/50 text-white font-semibold py-3 transition-all">
        🏆 <%= t("games.results.leaderboard") %>
      </a>
    </div>
  </div>
</div>
