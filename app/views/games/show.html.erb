<div class="shorts-container">
  <% if @game.current_video %>
    <div class="shorts-player" id="game-swipe-player"
         data-swipe-video-id="<%= @game.current_video.id %>"
         data-swipe-playlist-id="<%= @playlist.id %>"
         data-swipe-game-id="<%= @game.id %>">
      <!-- Vidéo -->
      <div class="shorts-video" id="game-swipe-card">
        <div id="video-container-<%= @game.current_video.id %>" style="width: 100%; height: 100%; position: relative;">
          <% 
            # Détection Safari mobile côté serveur
            # Uniquement en production, pour éviter les faux positifs en dev (Chrome + émulation iPhone)
            ua = request.user_agent.to_s
            is_safari_mobile = Rails.env.production? && ua.match?(/iPhone|iPad|iPod/) && ua.include?("Safari") && !ua.match?(/CriOS|Chrome/)
            
            # Toujours précharger la 1re vidéo pour éviter les écrans noirs au démarrage.
            base_url = request.base_url
            video_url = "https://www.youtube.com/embed/#{@game.current_video.youtube_id}?autoplay=1&controls=0&modestbranding=1&rel=0&playsinline=1&fs=1&disablekb=1&iv_load_policy=3&cc_load_policy=0&mute=1&loop=0&showinfo=0&enablejsapi=1&origin=#{CGI.escape(base_url)}"
          %>
          <% if is_safari_mobile %>
          <!-- Safari mobile : iframe chargée via JS au premier geste (pas de bouton Play). -->
          <iframe
            id="youtube-player-<%= @game.current_video.id %>"
            src="<%= video_url %>"
            title="YouTube"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="game-video-cover"
            style="display: block !important; width: 100vw !important; height: 56.25vw !important; position: fixed !important; top: 50% !important; left: 0 !important; border: none !important; pointer-events: auto !important; z-index: 1 !important; transform: translateY(-50%) scale(3) !important; transform-origin: center center !important; background: #000;">
          </iframe>
          <% else %>
          <iframe
            id="youtube-player-<%= @game.current_video.id %>"
            class="game-video-cover"
            src="<%= video_url %>"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen="true"
            style="width: 100vw !important; height: 56.25vw !important; position: fixed !important; top: 50% !important; left: 0 !important; border: none !important; pointer-events: none !important; z-index: 1 !important; transform: translateY(-50%) scale(3) !important; transform-origin: center center !important; background: #000;">
          </iframe>
          <% end %>
          
          <!-- Safari option A : 1 tap = lancer avec son ; si iOS bloque l'autoplay, l'utilisateur tape sur le Play YouTube -->
          <% if !is_safari_mobile %>
          <!-- Overlay de chargement pour autres navigateurs -->
          <div id="video-loading-<%= @game.current_video.id %>" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 5; display: flex; align-items: center; justify-content: center; flex-direction: column;">
            <div style="color: white; text-align: center; padding: 20px;">
              <p style="margin-bottom: 20px; font-size: 18px;">Chargement de la vidéo...</p>
              <div style="width: 50px; height: 50px; border: 4px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto;"></div>
            </div>
          </div>
          <% end %>
          
          <!-- Message d'erreur : retry, passer à la suivante (vidéo indisponible type logranvic), ou ouvrir YouTube -->
          <div id="video-error-<%= @game.current_video.id %>" style="display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10; background: rgba(0,0,0,0.9); padding: 30px; border-radius: 15px; color: white; text-align: center; max-width: 90%;">
            <p style="margin-bottom: 20px; font-size: 16px;">La vidéo ne se charge pas</p>
            <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 12px;">
              <button onclick="retryVideoLoad('<%= @game.current_video.id %>', '<%= @game.current_video.youtube_id %>')" style="background: #9333ea; color: white; border: none; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-size: 16px; font-weight: bold;">Réessayer</button>
              <button id="video-error-skip-btn" style="background: #6b7280; color: white; border: none; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-size: 16px; font-weight: bold;">Passer à la suivante</button>
              <a href="https://www.youtube.com/watch?v=<%= @game.current_video.youtube_id %>" target="_blank" style="display: inline-block; background: #ff0000; color: white; border: none; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-size: 16px; font-weight: bold;">Ouvrir sur YouTube</a>
            </div>
            <p style="font-size: 12px; opacity: 0.7;">Si la vidéo est indisponible, utilisez « Passer à la suivante »</p>
          </div>
        </div>
        
        <style>
          @keyframes spin {
            to { transform: rotate(360deg); }
          }
        </style>
        
        <script>
          (function() {
            const videoId = '<%= @game.current_video.id %>';
            const youtubeId = '<%= @game.current_video.youtube_id %>';
            const iframe = document.getElementById('youtube-player-' + videoId);
            const loadingDiv = document.getElementById('video-loading-' + videoId);
            const errorDiv = document.getElementById('video-error-' + videoId);
            
            if (!iframe) return;
            
            // Détection Safari mobile
            const isSafariMobile = /iPhone|iPad|iPod/.test(navigator.userAgent) && !window.MSStream;
            
            let loadCheckTimeout;
            let hasLoaded = false;
            let errorShown = false;
            
            // Fonction pour masquer le loader et afficher la vidéo
            function hideLoader() {
              if (loadingDiv) {
                loadingDiv.style.display = 'none';
              }
              if (errorDiv) {
                errorDiv.style.display = 'none';
              }
            }
            
            // Fonction pour afficher l'erreur
            function showError() {
              if (errorShown) return;
              errorShown = true;
              if (loadingDiv) loadingDiv.style.display = 'none';
              if (errorDiv) errorDiv.style.display = 'block';
            }
            
            // Vérifier que l'iframe se charge correctement
            function checkIframeLoad() {
              // Pour Safari mobile, timeout plus long (5 secondes) car le chargement peut être plus lent
              const timeoutDuration = isSafariMobile ? 5000 : 3000;
              
              loadCheckTimeout = setTimeout(function() {
                if (!hasLoaded) {
                  console.warn('Timeout de chargement après ' + timeoutDuration + 'ms');
                  // Afficher l'erreur après le timeout
                  showError();
                }
              }, timeoutDuration);
            }
            
            // Écouter l'événement load de l'iframe
            iframe.addEventListener('load', function() {
              hasLoaded = true;
              clearTimeout(loadCheckTimeout);
              console.log('✅ Iframe chargée avec succès');
              
              // Masquer le loader immédiatement après le load
              hideLoader();
              
              // Pour Safari mobile, attendre un peu plus pour voir si la vidéo démarre
              if (isSafariMobile) {
                // Sur Safari, même si l'iframe charge, l'autoplay peut être bloqué
                // On masque le loader et on laisse l'utilisateur interagir
                setTimeout(function() {
                  console.log('Safari mobile: Vidéo prête (autoplay peut nécessiter interaction)');
                }, 500);
              }
            });
            
            // Écouter les erreurs
            iframe.addEventListener('error', function() {
              console.error('❌ Erreur de chargement de l\'iframe');
              showError();
            });
            
            // Safari option A : 1 tap = recharge lecture si iOS bloque l'autoplay.
            window.loadVideoOnSafari = function(videoId, youtubeId) {
              var playButton = document.getElementById('video-play-button-' + videoId) || document.querySelector('[id^="video-play-button-"]');
              if (playButton) playButton.style.display = 'none';
              var iframe = document.querySelector('iframe[id^="youtube-player-"]');
              if (!iframe) return;
              var muteValue = window.__tnpSoundEnabled ? '0' : '1';
              var controlsValue = window.__tnpSoundEnabled ? '1' : '0';
              var url = 'https://www.youtube.com/embed/' + youtubeId + '?autoplay=1&mute=' + muteValue + '&playsinline=1&controls=' + controlsValue + '&rel=0&modestbranding=1';
              iframe.src = url;
              iframe.style.setProperty('display', 'block', 'important');
              // En mode gameplay, l'iframe ne doit jamais capturer les interactions utilisateur.
              iframe.style.setProperty('pointer-events', 'none', 'important');
            };
            var playBtn = document.getElementById('safari-play-btn-' + videoId);
            if (playBtn && isSafariMobile) {
              function doPlay(e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                window.loadVideoOnSafari(videoId, youtubeId);
              }
              playBtn.addEventListener('click', function(e) { e.preventDefault(); doPlay(e); });
              playBtn.addEventListener('touchend', function(e) {
                e.preventDefault();
                e.stopPropagation();
                doPlay(e);
              }, { passive: false });
            }
            // Fonction de retry
            window.retryVideoLoad = function(videoId, youtubeId) {
              errorShown = false;
              hasLoaded = false;
              if (loadingDiv) loadingDiv.style.display = 'flex';
              if (errorDiv) errorDiv.style.display = 'none';
              
              // Pour Safari mobile, URL simplifiée sans origin
              let newUrl;
              if (isSafariMobile) {
                var safariMute = window.__tnpSoundEnabled ? '0' : '1';
                newUrl = 'https://www.youtube.com/embed/' + youtubeId + 
                  '?autoplay=1' +
                  '&mute=' + safariMute +
                  '&playsinline=1' +
                  '&controls=0' +
                  '&rel=0' +
                  '&modestbranding=1' +
                  '&t=' + Date.now();
              } else {
                const baseUrl = '<%= request.base_url %>';
                var defaultMute = window.__tnpSoundEnabled ? '0' : '1';
                newUrl = 'https://www.youtube.com/embed/' + youtubeId + 
                  '?autoplay=1' +
                  '&controls=0' +
                  '&modestbranding=1' +
                  '&rel=0' +
                  '&playsinline=1' +
                  '&fs=1' +
                  '&disablekb=1' +
                  '&iv_load_policy=3' +
                  '&cc_load_policy=0' +
                  '&mute=' + defaultMute +
                  '&loop=0' +
                  '&showinfo=0' +
                  '&enablejsapi=1' +
                  '&origin=' + encodeURIComponent(baseUrl) +
                  '&t=' + Date.now();
              }
              
              iframe.src = '';
              setTimeout(function() {
                iframe.src = newUrl;
                checkIframeLoad();
              }, 500);
            };
            
            // Vérifier systématiquement le chargement initial, y compris Safari.
            checkIframeLoad();
            setTimeout(function() {
              if (loadingDiv && loadingDiv.style.display !== 'none' && !hasLoaded) {
                loadingDiv.style.display = 'none';
              }
            }, 3000);
          })();
        </script>
      </div>

      <!-- Zone en bas : ne pas intercepter les touches (pointer-events: none) pour que Like/Dislike les reçoivent toujours -->
      <div class="shorts-controls-zone" id="game-controls-zone" style="position: fixed !important; bottom: 0 !important; left: 0 !important; right: 0 !important; height: 140px !important; z-index: 999998 !important; pointer-events: none !important;"></div>
      <!-- Contrôles et boutons Like/Dislike : au-dessus de la zone, reçoivent tous les clics/touches -->
      <div class="shorts-controls" style="z-index: 2147483647 !important; pointer-events: auto !important;">
        <div class="shorts-audio-row">
          <button type="button" id="game-audio-toggle" class="audio-toggle-btn" aria-pressed="false">
            Son off
          </button>
        </div>
        <div class="shorts-info">
          <h2><%= @game.current_video.title %></h2>
          <p><%= @playlist.title %></p>
        </div>

        <div class="shorts-actions" style="pointer-events: auto !important;">
          <button type="button" class="action-btn dislike" id="game-btn-dislike" style="pointer-events: auto !important; cursor: pointer !important;" onclick="if(window.__tnpDirectSwipe){window.__tnpDirectSwipe('dislike');return false;}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="action-icon">
              <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="action-btn like" id="game-btn-like" style="pointer-events: auto !important; cursor: pointer !important;" onclick="if(window.__tnpDirectSwipe){window.__tnpDirectSwipe('like');return false;}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="action-icon">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div id="game-swipe-feedback" style="display:none; position:fixed; inset:0; z-index:2147483648; pointer-events:none;">
      <div id="game-feedback-backdrop" style="position:absolute; inset:0; background:rgba(0,0,0,0.15); backdrop-filter: blur(2px); transition: background 160ms ease-out;"></div>
      <div style="position:absolute; left:50%; top:35%; transform:translate(-50%,-50%); width:min(86vw,320px);">
        <div id="game-feedback-card" style="border-radius:24px; border:1px solid rgba(168,85,247,0.45); background:rgba(20,20,30,0.72); box-shadow:0 16px 45px rgba(0,0,0,0.45); padding:16px; text-align:center; transform:scale(0.92); opacity:0.9; transition:transform 180ms ease-out, opacity 180ms ease-out, border-color 180ms ease-out;">
          <div id="game-feedback-emoji" style="font-size:40px; line-height:1; margin-bottom:8px;">✨</div>
          <div id="game-feedback-title" style="color:#fff; font-weight:800; font-size:22px; margin-bottom:4px;">Bravo !</div>
          <div id="game-feedback-points" style="color:rgba(255,255,255,0.82); font-size:14px;">+2 pts</div>
          <div id="game-feedback-streak" style="color:#f5d0fe; font-size:18px; font-weight:900; margin-top:6px; min-height:24px; letter-spacing:0.4px; text-shadow:0 0 12px rgba(216,180,254,0.45);"></div>
          <div style="margin-top:10px; height:8px; border-radius:9999px; background:rgba(255,255,255,0.14); overflow:hidden;">
            <div id="game-feedback-bar" style="height:100%; width:0%; border-radius:9999px; background:linear-gradient(90deg,#7e22ce,#a855f7,#d946ef);"></div>
          </div>
        </div>
      </div>
    </div>

    <style>
      @keyframes gameBtnPulse {
        0% { transform: scale(1); }
        35% { transform: scale(1.12); }
        100% { transform: scale(1); }
      }
      @keyframes unlockSparkleBurst {
        0% { transform: translate(-50%, -50%) scale(0.25); opacity: 0; }
        25% { opacity: 1; }
        100% { transform: translate(var(--tx), var(--ty)) scale(1.1); opacity: 0; }
      }
      @keyframes unlockCardIn {
        0% { transform: translateY(14px) scale(0.92); opacity: 0; }
        100% { transform: translateY(0) scale(1); opacity: 1; }
      }
      @keyframes gameFeedbackPulse {
        0% { transform: scale(0.92); opacity: 0.9; }
        100% { transform: scale(1); opacity: 1; }
      }
      .game-btn-pulse {
        animation: gameBtnPulse 260ms ease-out;
      }
      .game-feedback-pop {
        animation: gameFeedbackPulse 180ms ease-out forwards;
      }
      .unlock-sparkle {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: radial-gradient(circle, #fff 0%, #fde68a 45%, #f472b6 100%);
        box-shadow: 0 0 12px rgba(255,255,255,0.85), 0 0 26px rgba(251,191,36,0.65);
        animation: unlockSparkleBurst 900ms ease-out forwards;
        pointer-events: none;
      }
      .unlock-cinematic-card {
        animation: unlockCardIn 220ms ease-out forwards;
      }
    </style>

    <script>
    (function() {
      // Fallback robuste : si l'init gameplay ne s'accroche pas,
      // les boutons déclenchent quand même le swipe côté serveur.
      window.__tnpDirectSwipe = function(direction) {
        try {
          if (window.__tnpDirectSwipeLock) return;
          window.__tnpDirectSwipeLock = true;

          var csrf = document.querySelector('meta[name="csrf-token"]');
          var token = csrf ? csrf.getAttribute('content') : '';
          var watchedSeconds = 10;
          var swipeUrl = window.location.pathname.replace(/\/$/, '') + '/swipe';

          fetch(swipeUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': token,
              'Accept': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({ direction: direction, watched_seconds: watchedSeconds })
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && data.redirect) {
              window.location.href = data.redirect;
              return;
            }
            window.location.reload();
          })
          .catch(function() {
            window.location.reload();
          })
          .finally(function() {
            setTimeout(function() { window.__tnpDirectSwipeLock = false; }, 1200);
          });
        } catch (_) {
          window.__tnpDirectSwipeLock = false;
        }
      };
    })();
    </script>
    <script>
    (function() {
      function initGameSwipe() {
        var player = document.getElementById('game-swipe-player');
        if (!player) { console.warn('[Game] game-swipe-player non trouvé'); return; }
        var iframeGuardObserver = null;

        function enforceIframeNoPointerEvents() {
          var iframe = document.querySelector('#game-swipe-player iframe.game-video-cover');
          if (!iframe) return;
          iframe.style.setProperty('pointer-events', 'none', 'important');
          iframe.style.setProperty('user-select', 'none', 'important');
          iframe.style.setProperty('-webkit-user-select', 'none', 'important');
          iframe.style.setProperty('-webkit-touch-callout', 'none', 'important');
        }

        // Appliquer immédiatement et re-appliquer régulièrement (simulateur mobile Chrome).
        enforceIframeNoPointerEvents();
        setInterval(enforceIframeNoPointerEvents, 500);

        var isProcessing = false;
        var videoStartedAtMs = Date.now();
        var currentYoutubeId = '<%= @game.current_video.youtube_id %>';
        var feedbackTimeout = null;
        var feedbackBarTimeout = null;
        var processingWatchdog = null;
        var processingSinceMs = 0;
        var lastSwipeType = null;
        var streakCount = 0;

        var locale = '<%= I18n.locale.to_s %>';
        var isEnglish = locale === 'en';
        var feedbackMessages = isEnglish ? {
          like: ['Wow!', 'OMG!', 'You got this!'],
          dislike: ["You're like that huh!", 'OK!', 'Wassup!', 'It sucks!']
        } : {
          like: ['Wow !', 'OMG !', 'Tu gere !'],
          dislike: ["T'es comme ca toi !", 'Ok !', 'Nan !', 'Braaaaa! ', 'C Komen']
        };

        function randomMessage(type) {
          var list = feedbackMessages[type] || ['Continue !'];
          return list[Math.floor(Math.random() * list.length)];
        }

        function showSwipeFeedback(liked) {
          var overlay = document.getElementById('game-swipe-feedback');
          if (!overlay) return;

          var emojiEl = document.getElementById('game-feedback-emoji');
          var titleEl = document.getElementById('game-feedback-title');
          var pointsEl = document.getElementById('game-feedback-points');
          var streakEl = document.getElementById('game-feedback-streak');
          var barEl = document.getElementById('game-feedback-bar');
          var cardEl = document.getElementById('game-feedback-card');
          var backdropEl = document.getElementById('game-feedback-backdrop');

          var currentType = liked ? 'like' : 'dislike';
          if (lastSwipeType === currentType) {
            streakCount += 1;
          } else {
            streakCount = 1;
            lastSwipeType = currentType;
          }

          if (emojiEl) emojiEl.textContent = liked ? '💜' : '⚡';
          var baseTitle = randomMessage(liked ? 'like' : 'dislike');
          if (titleEl) titleEl.textContent = baseTitle;
          if (pointsEl) pointsEl.textContent = liked ? '+2 pts' : '+1 pt';
          if (cardEl) {
            cardEl.style.borderColor = liked ? 'rgba(192,132,252,0.95)' : 'rgba(248,113,113,0.9)';
            cardEl.classList.remove('game-feedback-pop');
            void cardEl.offsetWidth;
            cardEl.classList.add('game-feedback-pop');
          }
          if (backdropEl) {
            backdropEl.style.background = liked ? 'rgba(126,34,206,0.28)' : 'rgba(185,28,28,0.24)';
          }
          if (streakEl) {
            if (streakCount >= 2) {
              var streakLabel = streakCount >= 5 ? 'LEGEND' : 'COMBO';
              var streakText = 'x' + streakCount + ' ' + streakLabel;
              streakEl.textContent = streakText;
              if (titleEl) titleEl.textContent = baseTitle + '  •  ' + streakText;
            } else {
              streakEl.textContent = '';
            }
          }

          overlay.style.display = 'block';
          overlay.style.opacity = '1';
          if (barEl) {
            barEl.style.transition = 'none';
            barEl.style.width = '0%';
            clearTimeout(feedbackBarTimeout);
            feedbackBarTimeout = setTimeout(function() {
              barEl.style.transition = 'width 520ms ease-out';
              barEl.style.width = streakCount >= 3 ? '100%' : (liked ? '90%' : '70%');
            }, 20);
          }

          clearTimeout(feedbackTimeout);
          feedbackTimeout = setTimeout(function() {
            overlay.style.opacity = '0';
            if (backdropEl) backdropEl.style.background = 'rgba(0,0,0,0.15)';
            setTimeout(function() {
              overlay.style.display = 'none';
            }, 120);
          }, 1000);
        }

        function pulseButton(liked) {
          var targetBtn = document.getElementById(liked ? 'game-btn-like' : 'game-btn-dislike');
          if (!targetBtn) return;
          targetBtn.classList.remove('game-btn-pulse');
          // force reflow to replay animation
          void targetBtn.offsetWidth;
          targetBtn.classList.add('game-btn-pulse');
        }

      var soundEnabled = (function() {
        try { return sessionStorage.getItem('tnp_sound_enabled') === '1'; } catch (_) { return false; }
      })();
      window.__tnpSoundEnabled = soundEnabled;

      function persistSoundPreference(value) {
        soundEnabled = !!value;
        window.__tnpSoundEnabled = soundEnabled;
        try { sessionStorage.setItem('tnp_sound_enabled', soundEnabled ? '1' : '0'); } catch (_) {}
      }

      function audioButtonLabel() {
        return soundEnabled ? 'Son on' : 'Son off';
      }

      function updateAudioButton() {
        var btn = document.getElementById('game-audio-toggle');
        if (!btn) return;
        btn.textContent = audioButtonLabel();
        btn.setAttribute('aria-pressed', soundEnabled ? 'true' : 'false');
      }

      function buildEmbedUrl(youtubeId, baseOrigin) {
        var muteValue = soundEnabled ? '0' : '1';
        var controlsValue = soundEnabled ? '1' : '0';
        var origin = baseOrigin || window.location.origin;
        return 'https://www.youtube.com/embed/' + youtubeId +
          '?autoplay=1&controls=' + controlsValue + '&modestbranding=1&rel=0&playsinline=1&fs=1&disablekb=1' +
          '&iv_load_policy=3&cc_load_policy=0&mute=' + muteValue + '&showinfo=0&enablejsapi=1&origin=' + encodeURIComponent(origin);
      }

      function reloadCurrentVideoWithAudioPreference() {
        var iframe = document.querySelector('iframe[id^="youtube-player-"]');
        if (!iframe || !currentYoutubeId) return;
        // En mode gameplay, conserver les interactions sur les boutons/gestes du jeu.
        iframe.style.pointerEvents = 'none';
        iframe.src = buildEmbedUrl(currentYoutubeId);
      }

      function getData() {
        var data = {
          videoId: player.getAttribute('data-swipe-video-id'),
          playlistId: player.getAttribute('data-swipe-playlist-id'),
          gameId: player.getAttribute('data-swipe-game-id')
        };

        // Fallback défensif: tenter d'extraire playlist/game depuis l'URL.
        if ((!data.playlistId || !data.gameId) && window.location.pathname) {
          var m = window.location.pathname.match(/\/playlists\/(\d+)\/games\/(\d+)/);
          if (m) {
            data.playlistId = data.playlistId || m[1];
            data.gameId = data.gameId || m[2];
          }
        }
        return data;
      }

      function clearProcessingState() {
        isProcessing = false;
        processingSinceMs = 0;
        setButtonsEnabled(true);
        clearTimeout(processingWatchdog);
        processingWatchdog = null;
      }

      // Debug helper in browser console.
      window.__tnpResetSwipeState = clearProcessingState;

      function setButtonsEnabled(enabled) {
        var btns = player.querySelectorAll('.action-btn');
        btns.forEach(function(btn) {
          btn.disabled = !enabled;
          btn.style.opacity = enabled ? '1' : '0.5';
        });
      }

      function resetCardTransform() {
        var iframe = document.querySelector('#game-swipe-player iframe.game-video-cover');
        if (!iframe) return;
        iframe.style.transition = 'transform 480ms cubic-bezier(0.22, 1, 0.36, 1)';
        iframe.style.transform = 'translateX(0px) translateY(-50%) rotate(0deg) scale(3)';
      }

      // TikTok/Tinder gesture : la "carte" = la vidéo elle-même.
      // Swipe horizontal -> translation + rotation max ~15deg, snap-back ou "throw".
      function clamp(num, min, max) {
        return Math.min(Math.max(num, min), max);
      }

      var gameCardEl = document.getElementById('game-swipe-card');
      var iframeEl = document.querySelector('#game-swipe-player iframe.game-video-cover');
      var isDragging = false;
      var isGestureAnimating = false;
      var startX = 0;
      var dx = 0;

      if (gameCardEl && iframeEl) {
        gameCardEl.style.touchAction = 'pan-y';
        gameCardEl.style.willChange = 'transform';
        resetCardTransform();

        function shouldIgnoreTarget(t) {
          if (!t) return true;
          if (t.closest && t.closest('.action-btn')) return true;
          return false;
        }

        gameCardEl.addEventListener('pointerdown', function(e) {
          if (isProcessing || isGestureAnimating) return;
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          if (shouldIgnoreTarget(e.target)) return;

          // Safari mobile : si l'iframe est encore vide/masquée, on la charge sur le premier geste.
          var isSafariMobile = /iPhone|iPad|iPod/.test(navigator.userAgent) && !window.MSStream;
          if (isSafariMobile && typeof window.loadVideoOnSafari === 'function') {
            try {
              window.loadVideoOnSafari('<%= @game.current_video.id %>', '<%= @game.current_video.youtube_id %>');
            } catch (_) {}
          }

          isDragging = true;
          startX = e.clientX;
          dx = 0;
          gameCardEl.setPointerCapture(e.pointerId);
          gameCardEl.style.transition = 'none';
          iframeEl.style.transition = 'none';
        }, { passive: true });

        gameCardEl.addEventListener('pointermove', function(e) {
          if (!isDragging) return;
          dx = e.clientX - startX;

          var width = window.innerWidth || 414;
          var maxRotation = 15;
          var tx = clamp(dx, -width * 0.6, width * 0.6);
          var rot = clamp((tx / width) * maxRotation, -maxRotation, maxRotation);

          iframeEl.style.transform = 'translateX(' + tx + 'px) translateY(-50%) rotate(' + rot + 'deg) scale(3)';
        }, { passive: true });

        function onPointerEnd() {
          if (!isDragging) return;
          isDragging = false;

          var width = window.innerWidth || 414;
          var threshold = width * 0.18;
          var absDx = Math.abs(dx);
          var liked = dx > 0;

          if (absDx < threshold) {
            resetCardTransform();
            return;
          }

          isGestureAnimating = true;
          setButtonsEnabled(false);

          var dir = liked ? 1 : -1;
          var targetX = dir * width * 1.1;
          var targetRot = dir * 18; // + tilt quand on "throw"

          iframeEl.style.transition = 'transform 260ms ease-out';
          iframeEl.style.transform = 'translateX(' + targetX + 'px) translateY(-50%) rotate(' + targetRot + 'deg) scale(3)';

          var onEnd = function() {
            iframeEl.removeEventListener('transitionend', onEnd);
            // lancer l'action une fois l'animation hors écran
            isGestureAnimating = false;
            handleSwipe(liked);
          };
          iframeEl.addEventListener('transitionend', onEnd, { once: true });
          setTimeout(function() {
            if (!isProcessing && isGestureAnimating) {
              isGestureAnimating = false;
              handleSwipe(liked);
            }
          }, 320);
        }

        gameCardEl.addEventListener('pointerup', onPointerEnd, { passive: true });
        gameCardEl.addEventListener('pointercancel', onPointerEnd, { passive: true });
      }

      function handleSwipe(liked) {
        if (isProcessing) {
          if (processingSinceMs && (Date.now() - processingSinceMs) > 1200) {
            console.warn('[Game] forcing stale processing reset');
            clearProcessingState();
          } else {
            console.warn('[Game] swipe ignored: processing already in progress');
            return;
          }
        }
        pulseButton(liked);
        var d = getData();
        console.log('[Game] handleSwipe', liked ? 'like' : 'dislike', d);
        if (!d.videoId || !d.playlistId || !d.gameId) {
          alert('Données manquantes. Rechargez la page.');
          return;
        }
        isProcessing = true;
        processingSinceMs = Date.now();
        setButtonsEnabled(false);
        processingWatchdog = setTimeout(function() {
          console.warn('[Game] swipe watchdog reset (timeout)');
          clearProcessingState();
        }, 8000);

        var csrf = document.querySelector('meta[name="csrf-token"]');
        var token = csrf ? csrf.getAttribute('content') : '';
        var localePrefix = '';
        var path = window.location.pathname || '';
        var localeMatch = path.match(/^\/(fr|en)(\/|$)/);
        if (localeMatch) localePrefix = '/' + localeMatch[1];
        var watchedSeconds = Math.max(0, Math.floor((Date.now() - videoStartedAtMs) / 1000));

        fetch(localePrefix + '/swipes', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': token,
            'Accept': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            video_id: d.videoId,
            playlist_id: d.playlistId,
            game_id: d.gameId,
            liked: liked,
            watched_seconds: watchedSeconds
          })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.success) {
            if (data.redirect) window.location.href = data.redirect;
            else { clearProcessingState(); alert(data.error || 'Erreur'); }
            return;
          }

          // (Visuel swipe) Pas d'overlay de points ici : la vidéo suit le geste.
          function continueGameFlow() {
            if (data.completed) {
              window.location.href = data.redirect || '/playlists/' + d.playlistId + '/games/' + d.gameId + '/results';
              return;
            }
            if (data.next_video_id && data.next_video_youtube_id) {
              var isSafari = /iPhone|iPad|iPod/.test(navigator.userAgent) && !window.MSStream;
              player.setAttribute('data-swipe-video-id', String(data.next_video_id));
              var titleEl = document.querySelector('.shorts-info h2');
              if (titleEl && data.next_video_title) titleEl.textContent = data.next_video_title;

              if (isSafari && typeof window.loadVideoOnSafari === 'function') {
                // Vidéo suivante avec son (iframe) ; si iOS bloque l'autoplay, l'utilisateur tape sur le Play YouTube
                window.loadVideoOnSafari(data.next_video_id, data.next_video_youtube_id);
              } else {
                var iframe = document.querySelector('iframe[id^="youtube-player-"]');
                if (iframe) {
                  iframe.style.pointerEvents = 'none';
                  iframe.src = buildEmbedUrl(data.next_video_youtube_id);
                  enforceIframeNoPointerEvents();
                } else {
                  window.location.href = data.redirect || '/playlists/' + d.playlistId + '/games/' + d.gameId;
                  return;
                }
              }
              currentYoutubeId = data.next_video_youtube_id;
              videoStartedAtMs = Date.now();
              resetCardTransform();
              clearProcessingState();
            } else {
              window.location.href = data.redirect || '/playlists/' + d.playlistId + '/games/' + d.gameId;
            }
          }

          function showConcertUnlockSplash(unlocks, dailyBonus, done) {
            try {
              var title = null;
              var subtitle = null;
              var emoji = 'TROPHY';
              var visual = '';
              var tagLabel = '';
              var currentPoints = Number(data.journey_total || 0);
              var targetPoints = 0;
              var progressPercent = 0;
              var sparkles = '';

              for (var i = 0; i < 20; i += 1) {
                var angle = (Math.PI * 2 * i) / 20;
                var radius = 70 + Math.random() * 120;
                var tx = Math.cos(angle) * radius;
                var ty = Math.sin(angle) * radius;
                var delay = Math.floor(Math.random() * 220);
                sparkles += '<span class="unlock-sparkle" style="--tx:' + tx.toFixed(1) + 'px;--ty:' + ty.toFixed(1) + 'px;animation-delay:' + delay + 'ms;"></span>';
              }

              if (unlocks && unlocks.indexOf('concert_ticket') >= 0) {
                title = 'CONCERT PHYSIQUE DEBLOQUE';
                subtitle = 'Palier 4500 points atteint';
                tagLabel = 'PHYSIQUE';
                targetPoints = 4500;
                progressPercent = Math.min(100, Math.round((currentPoints / targetPoints) * 100));
                visual =
                  '<div class="relative overflow-hidden rounded-2xl" style="height: 12rem;">' +
                    '<video autoplay loop muted playsinline class="w-full h-full object-cover concert-media-pulse" src="<%= asset_path("concerts/concert_physique.mp4") %>"></video>' +
                    '<div class="pointer-events-none absolute inset-0" style="background: linear-gradient(180deg, #f59e0b 0%, #6b21a8 60%, #111827 100%); opacity: 0.50;"></div>' +
                    '<div class="absolute top-3 right-3"><span class="rounded-full px-3 py-1 text-xs font-bold bg-black text-amber-200">' + tagLabel + '</span></div>' +
                  '</div>';
              } else if (unlocks && unlocks.indexOf('concert_link') >= 0) {
                title = 'CONCERT LIVE DEBLOQUE';
                subtitle = 'Palier 2000 points atteint';
                tagLabel = 'LIVE';
                targetPoints = 2000;
                progressPercent = Math.min(100, Math.round((currentPoints / targetPoints) * 100));
                visual =
                  '<div class="relative overflow-hidden rounded-2xl" style="height: 12rem;">' +
                    '<video autoplay loop muted playsinline class="w-full h-full object-cover concert-media-pulse" src="<%= asset_path("concerts/concert_live.mp4") %>"></video>' +
                    '<div class="pointer-events-none absolute inset-0" style="background: linear-gradient(180deg, #a855f7 0%, #6b21a8 55%, #111827 100%); opacity: 0.50;"></div>' +
                    '<div class="absolute top-3 right-3"><span class="rounded-full px-3 py-1 text-xs font-bold bg-white text-black">' + tagLabel + '</span></div>' +
                  '</div>';
              } else if (dailyBonus && Number(dailyBonus) > 0) {
                title = 'BONUS QUOTIDIEN';
                subtitle = '+' + dailyBonus + ' pts (3 playlists jouees)';
                emoji = 'FIRE';
                visual = '<div style="width:100%;height:72px;display:flex;align-items:center;justify-content:center;border-radius:14px;background:rgba(255,255,255,0.09);border:1px solid rgba(255,255,255,0.22);margin:10px 0 4px 0;font-size:30px;">🔥</div>';
              }

              if (!title) { done(); return; }

              var splash = document.createElement('div');
              splash.style.cssText = 'position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 25%, rgba(168,85,247,0.55), rgba(0,0,0,0.93));backdrop-filter:blur(5px);';
              splash.innerHTML =
                '<div style="position:relative;width:min(92vw,410px);">' +
                  sparkles +
                  '<div class="unlock-cinematic-card relative overflow-hidden rounded-[2rem] bg-gradient-to-b from-[#6b21a8]/95 to-[#1d4ed8]/95 text-white shadow-2xl" style="padding:18px;border:1px solid rgba(255,255,255,0.22);">' +
                  '<div style="font-size:38px;line-height:1">' + (emoji === 'FIRE' ? '🔥' : '🏆') + '</div>' +
                  '<div style="margin-top:10px;font-size:11px;font-weight:900;letter-spacing:0.24em;opacity:0.9">LEVEL UP</div>' +
                  '<div style="margin-top:8px;font-size:24px;font-weight:900;line-height:1.2;">' + title + '</div>' +
                  visual +
                  (targetPoints > 0
                    ? '<div style="margin-top:10px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;opacity:0.95;"><span>' + currentPoints + ' / ' + targetPoints + ' pts</span><span>' + progressPercent + '%</span></div>' +
                      '<div style="margin-top:6px;height:8px;border-radius:9999px;background:rgba(255,255,255,0.16);overflow:hidden;"><div style="height:100%;width:' + progressPercent + '%;border-radius:9999px;background:#fff;"></div></div>'
                    : '') +
                  '<div style="margin-top:8px;font-size:13px;opacity:0.92;">' + subtitle + '</div>' +
                  '</div>' +
                '</div>';
              document.body.appendChild(splash);
              var card = splash.querySelector('.unlock-cinematic-card');
              setTimeout(function() { card.style.transform = 'scale(1)'; card.style.opacity = '1'; }, 20);
              setTimeout(function() {
                splash.style.transition = 'opacity 220ms ease';
                splash.style.opacity = '0';
                setTimeout(function() {
                  if (splash.parentNode) splash.parentNode.removeChild(splash);
                  done();
                }, 230);
              }, 2400);
            } catch (e) {
              console.error('unlock splash error', e);
              done();
            }
          }

          var hasUnlockCinematic = (data.journey_unlocks && data.journey_unlocks.length > 0) || (Number(data.daily_connection_bonus || 0) > 0);
          if (hasUnlockCinematic) {
            // Priorité à la cinématique palier/bonus: pas de mini feedback texte avant.
            showConcertUnlockSplash(data.journey_unlocks || [], data.daily_connection_bonus, continueGameFlow);
          } else {
            showSwipeFeedback(liked);
            setTimeout(continueGameFlow, 260);
          }
        })
        .catch(function(err) {
          console.error('Swipe error:', err);
          clearProcessingState();
          alert('Erreur de connexion. Réessayez.');
        });
      }

        // Exposer les fonctions globales pour les onclick/ontouchend inline (fallback fiable)
        window.gameSwipeLike = function() { handleSwipe(true); };
        window.gameSwipeDislike = function() { handleSwipe(false); };

        // Handlers directs sur les boutons
        var btnLike = document.getElementById('game-btn-like');
        var btnDislike = document.getElementById('game-btn-dislike');
        function bindButton(btn, liked) {
          if (!btn) return;
          function doSwipe(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            handleSwipe(liked);
          }
          btn.onclick = doSwipe;
          btn.ontouchend = function(e) {
            e.preventDefault();
            e.stopPropagation();
            handleSwipe(liked);
          };
        }
        bindButton(btnLike, true);
        bindButton(btnDislike, false);
        clearProcessingState();
        var skipBtn = document.getElementById('video-error-skip-btn');
        if (skipBtn) {
          skipBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            handleSwipe(false);
          });
          skipBtn.addEventListener('touchend', function(e) {
            e.preventDefault();
            e.stopPropagation();
            handleSwipe(false);
          }, { passive: false });
        }
        updateAudioButton();
        var audioBtn = document.getElementById('game-audio-toggle');
        if (audioBtn) {
          audioBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            persistSoundPreference(!soundEnabled);
            updateAudioButton();
            reloadCurrentVideoWithAudioPreference();
          });
          audioBtn.addEventListener('touchend', function(e) {
            e.preventDefault();
            e.stopPropagation();
            persistSoundPreference(!soundEnabled);
            updateAudioButton();
            reloadCurrentVideoWithAudioPreference();
          }, { passive: false });
        }
        console.log('[Game] Like/Dislike initialisés (boutons:', !!btnLike, !!btnDislike, ')');

        // Délégation en phase capture : intercepter touchend/click sur la zone des boutons (contourne touch-action: none du layout)
        var controlsEl = document.querySelector('.shorts-controls');
        if (controlsEl) {
          function onControlTouchOrClick(e) {
            var t = e.target;
            if (!t) return;
            if (btnLike && (t === btnLike || btnLike.contains(t))) {
              e.preventDefault();
              e.stopPropagation();
              handleSwipe(true);
              return;
            }
            if (btnDislike && (t === btnDislike || btnDislike.contains(t))) {
              e.preventDefault();
              e.stopPropagation();
              handleSwipe(false);
              return;
            }
          }
          controlsEl.addEventListener('touchend', onControlTouchOrClick, { capture: true, passive: false });
          controlsEl.addEventListener('click', onControlTouchOrClick, { capture: true });
        }

        // Capture au niveau document en secours (zone contrôle pour ne pas donner le focus à l'iframe)
        function onPlayerClick(e) {
          var zone = document.getElementById('game-controls-zone');
          if (zone && zone.contains(e.target)) {
            e.preventDefault();
            e.stopPropagation();
          }
        }
        document.addEventListener('click', onPlayerClick, true);
        document.addEventListener('touchend', onPlayerClick, true);

        // Observe les modifications de style sur l'iframe et restaure pointer-events:none.
        var guardedIframe = document.querySelector('#game-swipe-player iframe.game-video-cover');
        if (guardedIframe && window.MutationObserver) {
          iframeGuardObserver = new MutationObserver(function() {
            enforceIframeNoPointerEvents();
          });
          iframeGuardObserver.observe(guardedIframe, { attributes: true, attributeFilter: ['style'] });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGameSwipe);
      } else {
        initGameSwipe();
      }
    })();
    </script>
  <% else %>
    <div class="shorts-end">
      <div class="end-message">
        <h2>Playlist terminée !</h2>
        <%= link_to "Retour aux playlists", playlists_path, class: "end-button" %>
      </div>
    </div>
  <% end %>
</div>
