<div class="min-h-screen bg-[#f5f5f7] text-[#161616] pb-24">
  <div class="mx-auto max-w-md px-4 pt-6">
    <header class="mb-6 flex items-center justify-between">
      <h1 class="text-4xl font-extrabold tracking-tight text-[#8b5cf6]">Discover</h1>
      <div class="h-11 w-11 rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-[#8b5cf6]">
        <span class="text-xl">◉</span>
      </div>
    </header>

    <section class="mb-7">
      <div class="mb-3 flex items-center justify-between">
        <a href="<%= playlists_path %>" class="inline-flex items-center gap-1 text-4xl font-black text-[#111111] hover:text-[#6b21a8] transition">
          <span>Categories</span>
          <span class="text-3xl font-black">›</span>
        </a>
      </div>

      <div class="flex gap-3 overflow-x-auto pb-1 no-scrollbar">
        <% featured_category = @featured_playlist&.category.presence || @categories.first || "Discover" %>
        <% featured_thumb = @featured_playlist&.valid_thumbnail_id %>
        <a href="<%= playlists_test_category_path(category: featured_category) %>"
           class="relative block shrink-0 overflow-hidden rounded-2xl bg-black shadow-[0_12px_28px_rgba(0,0,0,0.18)]"
           style="width: 70%;">
          <div class="h-[177px] w-full">
            <% if featured_thumb.present? %>
              <img src="https://img.youtube.com/vi/<%= featured_thumb %>/hqdefault.jpg"
                   alt="<%= featured_category %>"
                   class="h-full w-full object-cover"
                   loading="lazy"
                   onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= featured_thumb %>/mqdefault.jpg';">
            <% else %>
              <div class="h-full w-full bg-gradient-to-br from-[#334155] to-[#0f172a]"></div>
            <% end %>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent"></div>
            <div class="absolute left-4 bottom-4 right-4">
              <p class="text-5xl font-black text-white leading-none truncate drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]"><%= featured_category %></p>
            </div>
          </div>
        </a>

        <% next_category = (@categories - [featured_category]).first || featured_category %>
        <% next_playlist = @playlists_test.find { |p| p.category == next_category } || @playlists_test.first %>
        <% next_thumb = next_playlist&.valid_thumbnail_id %>
        <a href="<%= playlists_test_category_path(category: next_category) %>"
           class="relative block shrink-0 overflow-hidden rounded-2xl bg-black shadow-[0_12px_28px_rgba(0,0,0,0.18)]"
           style="width: 70%;">
          <div class="h-[177px] w-full">
            <% if next_thumb.present? %>
              <img src="https://img.youtube.com/vi/<%= next_thumb %>/hqdefault.jpg"
                   alt="<%= next_category %>"
                   class="h-full w-full object-cover"
                   loading="lazy"
                   onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= next_thumb %>/mqdefault.jpg';">
            <% else %>
              <div class="h-full w-full bg-gradient-to-br from-[#374151] to-[#111827]"></div>
            <% end %>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent"></div>
            <div class="absolute left-4 bottom-4 right-4">
              <p class="text-4xl font-black text-white leading-none truncate drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]"><%= next_category %></p>
            </div>
          </div>
        </a>
      </div>
    </section>

    <section class="mb-7">
      <div class="mb-3 flex items-center justify-between">
        <a href="<%= playlists_path %>" class="inline-flex items-center gap-1 text-4xl font-black text-[#111111] hover:text-[#6b21a8] transition">
          <span>Trending Right Now</span>
          <span class="text-3xl font-black">›</span>
        </a>
      </div>
      <div class="flex gap-3 overflow-x-auto pb-1 no-scrollbar">
        <% @trending_playlists.first(4).each do |playlist| %>
          <% first_video = playlist.videos.first %>
          <% thumb_id = playlist.valid_thumbnail_id %>
          <% artist_name = first_video&.title.to_s.split("-").first.to_s.strip.presence || playlist.title %>
          <a href="<%= user_signed_in? ? new_playlist_game_path_with_locale(playlist) : new_user_session_path %>"
             class="relative block shrink-0 overflow-hidden rounded-2xl bg-white shadow-[0_10px_22px_rgba(0,0,0,0.12)]"
             style="width: 70%;">
            <div class="h-[177px] w-full">
              <% if thumb_id.present? %>
                <img src="https://img.youtube.com/vi/<%= thumb_id %>/hqdefault.jpg"
                     alt="<%= playlist.title %>"
                     class="h-full w-full object-cover"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= thumb_id %>/mqdefault.jpg';">
              <% else %>
                <div class="h-full w-full bg-gray-300"></div>
              <% end %>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute left-4 bottom-3 right-3">
                <p class="truncate text-3xl font-black text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]"><%= artist_name %></p>
              </div>
            </div>
          </a>
        <% end %>
      </div>
    </section>
  </div>
</div>

<style>
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
