<div class="min-h-screen bg-[#121214] pb-24 text-white">
  <div class="mx-auto max-w-md px-4 pt-6">
    <div class="mb-6 flex items-center gap-3">
      <%= link_to playlists_path, class: "inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 text-xl text-[#c4b5fd] ring-1 ring-white/10" do %>
        ‹
      <% end %>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-[#a855f7]">Catégorie</p>
        <h1 class="truncate text-2xl font-black text-white"><%= @category_name %></h1>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <% @category_playlists.each do |playlist| %>
        <% first_video = playlist.videos.first %>
        <% thumb_id = playlist.valid_thumbnail_id %>
        <% raw_title = first_video&.title.to_s.strip %>
        <% artist_name = (raw_title.present? ? raw_title.split(/ [-–—] /).first.to_s.strip.presence : nil) || playlist.title.to_s.strip.presence || "Playlist" %>
        <%= link_to(user_signed_in? ? new_playlist_game_path_with_locale(playlist) : new_user_session_path,
                    class: "relative flex flex-col overflow-hidden rounded-[14px] bg-zinc-900 shadow-[0_10px_22px_rgba(0,0,0,0.35)] ring-1 ring-white/5 transition hover:ring-[#a855f7]/40") do %>
          <div class="relative aspect-video w-full shrink-0 overflow-hidden">
            <% if thumb_id.present? %>
              <img src="https://img.youtube.com/vi/<%= thumb_id %>/hqdefault.jpg"
                   alt=""
                   class="playlist-card-media"
                   loading="lazy"
                   onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= thumb_id %>/mqdefault.jpg';">
            <% else %>
              <div class="absolute inset-0 bg-zinc-700"></div>
            <% end %>
          </div>
          <div class="flex shrink-0 flex-col items-center justify-center gap-0.5 px-2 py-2 text-center">
            <p class="line-clamp-2 text-center text-sm font-semibold leading-tight text-white"><%= artist_name %></p>
            <% if playlist.title.to_s.strip.present? && playlist.title.to_s.strip != artist_name %>
              <p class="line-clamp-1 text-center text-[11px] leading-tight text-white/55"><%= playlist.title %></p>
            <% end %>
          </div>
          <%= render "played_badge", playlist: playlist %>
        <% end %>
      <% end %>
    </div>

    <% if @category_playlists.blank? %>
      <div class="mt-8 rounded-2xl bg-zinc-900 p-4 text-sm text-white/70 ring-1 ring-white/10">
        Aucune playlist pour cette catégorie pour le moment.
      </div>
    <% end %>
  </div>
</div>
