<div class="min-h-screen bg-gray-900 py-0">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- En-tête avec logo -->
    <div class="text-center mb-4">
      <h1 class="text-2xl font-bold text-white"><%= t('playlists.title') %></h1>
    </div>

    <!-- Tags de catégories -->
    <div id="categories-section" class="mb-6">
      <h2 class="text-2xl font-bold text-white mb-6 text-center">🎵 <%= t('playlists.filters.by_category') %></h2>
        <% categories = ['Toutes', 'Pop', 'Rap', 'Hits', 'Afro', 'Electro', 'Rock', 'Reggae'] %>
      <div class="categories-grid mb-8">
        <% categories.each do |category| %>
          <% category_key = category.parameterize(separator: '_').underscore %>
          <button class="category-tag px-4 py-4 rounded-xl text-sm font-medium transition-all duration-200 bg-gray-800 text-gray-300 hover:bg-gray-700 hover:text-white border border-gray-700 hover:border-gray-600" data-category="<%= category %>">
              <%= t("playlists.categories.#{category_key}", default: category) %>
            </button>
        <% end %>
      </div>
      
    </div>

    <!-- Notification -->
    <% if flash[:alert] %>
      <div class="bg-red-500 text-white p-4 rounded-lg mb-8 max-w-2xl mx-auto">
        <%= flash[:alert] %>
      </div>
    <% end %>
    <% if flash[:notice] || params[:notice] %>
      <div class="bg-purple-500 text-white p-4 rounded-lg mb-8 max-w-2xl mx-auto flex flex-col items-center gap-4">
        <span><%= flash[:notice] || params[:notice] %></span>
      </div>
    <% end %>

    <!-- Liste unifiée de toutes les playlists -->
    <div id="all-playlists-section" class="mb-20 sm:mb-24 playlist-section">
      <h2 class="text-2xl font-bold text-white mb-6 border-b border-gray-800 pb-2"><%= t('playlists.all_playlists') %></h2>
      
      <div class="playlists-grid">
        <% all_playlists = @standard_playlists %>
        <% all_playlists.each do |playlist| %>
          <div class="playlist-item" 
               data-category="<%= playlist.category || 'Other' %>">
            <%= render 'playlist_card', playlist: playlist %>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>

