</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const categoryTags = document.querySelectorAll('.category-tag');
    
    // Gestion des tags de catégories
    categoryTags.forEach(tag => {
      tag.addEventListener('click', function() {
        const category = this.getAttribute('data-category');
        
        // Debug temporaire
        console.log('=== FILTRE CLIQUE ===');
        console.log('Catégorie sélectionnée:', category);
        
        // Mettre à jour les tags - état actif en violet
        categoryTags.forEach(t => t.classList.remove('bg-purple-600', 'text-white'));
        categoryTags.forEach(t => t.classList.add('bg-gray-800', 'text-gray-300'));
        this.classList.remove('bg-gray-800', 'text-gray-300');
        this.classList.add('bg-purple-600', 'text-white');
        
        // Filtrer les playlists dans la liste unifiée
        const allPlaylistItems = document.querySelectorAll('#all-playlists-section .playlist-item');
        console.log('Nombre de playlists trouvées:', allPlaylistItems.length);
        
        let visibleCount = 0;
        allPlaylistItems.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          let shouldShow = false;
          shouldShow = category === 'Toutes' ? true : itemCategory === category;
          
          console.log('Playlist:', itemCategory, 'Should show:', shouldShow);
          if (shouldShow) visibleCount++;
          item.style.display = shouldShow ? 'block' : 'none';
        });
        
        console.log('Playlists visibles:', visibleCount);
      });
    });
  });
  
  // Gestionnaire global pour les clics sur les playlists
  document.addEventListener('click', function(event) {
    const playlistCard = event.target.closest('.playlist-card-uniform');
    
    if (playlistCard) {
      event.preventDefault();
      event.stopPropagation();
      
      // Trouver le bouton dans la carte et exécuter son onclick
      const button = playlistCard.querySelector('button[onclick]');
      if (button) {
        const onclickCode = button.getAttribute('onclick');
        if (onclickCode) {
          eval(onclickCode);
        }
      }
    }
  });
</script>
