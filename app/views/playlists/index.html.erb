<div class="min-h-screen bg-[#121214] text-white pb-24">
  <div class="mx-auto max-w-md px-4 pt-6">
    <header class="mb-8 flex items-center justify-between">
      <h1 class="text-4xl font-extrabold tracking-tight text-[#a855f7]">Discover</h1>
      <% if user_signed_in? %>
        <%= link_to profile_path, class: "block h-[30px] w-[30px] shrink-0 overflow-hidden rounded-full bg-white/10 ring-2 ring-[#a855f7]/40 shadow-md" do %>
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar,
                          size: "30x30",
                          class: "block h-[30px] w-[30px] max-w-none rounded-full object-cover object-[center_20%]",
                          alt: "" %>
          <% else %>
            <span class="flex h-[30px] w-[30px] items-center justify-center text-sm font-black text-[#c4b5fd]">
              <%= current_user.email.to_s.first&.upcase || "?" %>
            </span>
          <% end %>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path, class: "flex h-[30px] w-[30px] shrink-0 items-center justify-center rounded-full bg-white/10 text-sm text-[#c4b5fd] ring-2 ring-[#a855f7]/30" do %>
          ◉
        <% end %>
      <% end %>
    </header>

    <section class="mb-12">
      <div class="mb-5 flex items-end justify-between gap-3">
        <h2 class="text-2xl font-black tracking-tight text-white">Categories</h2>
        <%= link_to playlists_categories_path, class: "shrink-0 text-sm font-semibold text-white/90 underline decoration-[#a855f7]/80 underline-offset-4 hover:text-[#e9d5ff]" do %>
          Voir tout
        <% end %>
      </div>

      <div class="flex gap-3 overflow-x-auto pb-1 no-scrollbar">
        <% featured_category = @featured_playlist&.category.to_s.strip.presence || @categories.first || "—" %>
        <% featured_thumb = @featured_playlist&.valid_thumbnail_id %>
        <a href="<%= playlists_category_path(category: featured_category) %>"
           class="discover-card-category flex shrink-0 flex-col overflow-hidden rounded-[14px] bg-zinc-900 shadow-[0_12px_28px_rgba(0,0,0,0.35)] ring-1 ring-white/5"
           style="width: 277px; height: 184px; min-width: 277px; min-height: 184px; border-radius: 14px;">
          <div class="relative min-h-0 w-full flex-1 basis-0 overflow-hidden">
            <% if featured_thumb.present? %>
              <img src="https://img.youtube.com/vi/<%= featured_thumb %>/hqdefault.jpg"
                   alt=""
                   class="playlist-card-media"
                   loading="lazy"
                   onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= featured_thumb %>/mqdefault.jpg';">
            <% else %>
              <div class="absolute inset-0 bg-gradient-to-br from-[#334155] to-[#0f172a]"></div>
            <% end %>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
          </div>
          <div class="relative z-10 shrink-0 border-t border-white/10 bg-zinc-950/95 px-2 py-2 text-center">
            <p class="line-clamp-2 text-sm font-bold leading-tight text-white"><%= featured_category %></p>
          </div>
        </a>

        <% next_category = (@categories - [featured_category]).first %>
        <% if next_category.present? %>
          <% next_playlist = @playlists_test.find { |p| p.category.to_s.strip == next_category } %>
          <% next_thumb = next_playlist&.valid_thumbnail_id %>
          <a href="<%= playlists_category_path(category: next_category) %>"
             class="discover-card-category flex shrink-0 flex-col overflow-hidden rounded-[14px] bg-zinc-900 shadow-[0_12px_28px_rgba(0,0,0,0.35)] ring-1 ring-white/5"
             style="width: 277px; height: 184px; min-width: 277px; min-height: 184px; border-radius: 14px;">
            <div class="relative min-h-0 w-full flex-1 basis-0 overflow-hidden">
              <% if next_thumb.present? %>
                <img src="https://img.youtube.com/vi/<%= next_thumb %>/hqdefault.jpg"
                     alt=""
                     class="playlist-card-media"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= next_thumb %>/mqdefault.jpg';">
              <% else %>
                <div class="absolute inset-0 bg-gradient-to-br from-[#374151] to-[#111827]"></div>
              <% end %>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
            </div>
            <div class="relative z-10 shrink-0 border-t border-white/10 bg-zinc-950/95 px-2 py-2 text-center">
              <p class="line-clamp-2 text-sm font-bold leading-tight text-white"><%= next_category %></p>
            </div>
          </a>
        <% end %>

        <a href="<%= playlists_categories_path %>"
           class="relative flex shrink-0 flex-col items-center justify-center gap-2 rounded-[14px] bg-gradient-to-br from-[#6b21a8]/90 to-[#1e1b4b] text-center shadow-[0_12px_28px_rgba(0,0,0,0.35)] ring-1 ring-white/10"
           style="width: 277px; height: 184px; min-width: 277px; min-height: 184px; border-radius: 14px;">
          <span class="text-lg font-black text-white">Voir tout</span>
          <span class="px-3 text-xs font-semibold text-white/75">Toutes les catégories</span>
        </a>
      </div>
    </section>

    <section class="mb-10">
      <div class="mb-10 flex items-end justify-between gap-3">
        <h2 class="text-2xl font-black tracking-tight text-white">Trending Right Now</h2>
        <%= link_to playlists_trending_path, class: "shrink-0 text-sm font-semibold text-white/90 underline decoration-[#a855f7]/80 underline-offset-4 hover:text-[#e9d5ff]" do %>
          Voir tout
        <% end %>
      </div>

      <div class="flex gap-3 overflow-x-auto pb-1 pt-1 no-scrollbar">
        <% @trending_playlists.first(2).each do |playlist| %>
          <% first_video = playlist.videos.first %>
          <% thumb_id = playlist.valid_thumbnail_id %>
          <% raw_title = first_video&.title.to_s.strip %>
          <% artist_name = (raw_title.present? ? raw_title.split(/ [-–—] /).first.to_s.strip.presence : nil) || playlist.title.to_s.strip.presence || "Playlist" %>
          <a href="<%= user_signed_in? ? new_playlist_game_path_with_locale(playlist) : new_user_session_path %>"
             class="discover-card-trending flex shrink-0 flex-col overflow-hidden rounded-[14px] bg-zinc-800 shadow-[0_10px_22px_rgba(0,0,0,0.35)] ring-1 ring-white/5"
             style="width: 210px; height: 188px; min-width: 210px; min-height: 188px; border-radius: 14px;">
            <div class="relative min-h-0 w-full flex-1 basis-0 overflow-hidden">
              <% if thumb_id.present? %>
                <img src="https://img.youtube.com/vi/<%= thumb_id %>/hqdefault.jpg"
                     alt=""
                     class="playlist-card-media"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='https://img.youtube.com/vi/<%= thumb_id %>/mqdefault.jpg';">
              <% else %>
                <div class="absolute inset-0 bg-zinc-600"></div>
              <% end %>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
            </div>
            <div class="relative z-10 shrink-0 border-t border-white/10 bg-zinc-950/95 px-2 py-2 text-center">
              <p class="line-clamp-2 text-xs font-bold leading-tight text-white"><%= artist_name %></p>
            </div>
          </a>
        <% end %>

        <a href="<%= playlists_trending_path %>"
           class="relative flex shrink-0 flex-col items-center justify-center gap-2 rounded-[14px] bg-gradient-to-br from-[#6b21a8]/90 to-[#1e1b4b] text-center shadow-[0_10px_22px_rgba(0,0,0,0.35)] ring-1 ring-white/10"
           style="width: 210px; height: 188px; min-width: 210px; min-height: 188px; border-radius: 14px;">
          <span class="text-base font-black leading-tight text-white sm:text-lg">Voir tout</span>
          <span class="px-3 text-center text-xs font-semibold leading-snug text-white/80">Toutes les artistes tendances</span>
        </a>
      </div>
    </section>
  </div>
</div>

<style>
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
