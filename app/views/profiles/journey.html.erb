<%# Concerts - Journey page %>
<style>
  /* Effet "visuel qui apparait / disparait" sur les cartes */
  .concert-media-pulse {
    animation: concertMediaPulse 6.5s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes concertMediaPulse {
    0%, 35% { opacity: 1; transform: scale(1.04); }
    48% { opacity: 0.18; transform: scale(1.07); }
    58% { opacity: 1; transform: scale(1.04); }
    100% { opacity: 1; transform: scale(1.04); }
  }
</style>

<div class="min-h-screen bg-black py-6">
  <div class="max-w-md mx-auto px-4">
    <div class="mb-6 rounded-3xl bg-gradient-to-b from-[#6b21a8]/70 to-[#1d4ed8]/70 p-5 shadow-xl">
      <h1 class="text-2xl font-extrabold text-white text-center tracking-wide uppercase">
        Ton concert ta saison
      </h1>

      <% if @season %>
        <p class="text-sm text-white/85 text-center mt-2 font-semibold">
          Saison 1 • concerts a gagner •
          <%= @season.starts_at.to_date.strftime('%d/%m') %> – <%= @season.ends_at.to_date.strftime('%d/%m') %>
        </p>
      <% end %>

      <p class="text-sm text-white/95 text-center mt-2">
        Points saison: <span class="font-extrabold"><%= @season_points.to_i %></span>
      </p>
    </div>

    <% progress_3000 = [[(@season_points.to_f / 3_000.0) * 100.0, 100].min, 0].max.round %>
    <% progress_6000 = [[(@season_points.to_f / 6_000.0) * 100.0, 100].min, 0].max.round %>
    <% use_live_video = true %>
    <% use_physique_video = true %>

    <div class="space-y-4">
      <%= render "shared/card_concert",
                 variant: :live,
                 season_points: @season_points,
                 target_points: 3_000,
                 video_key: "concerts/concert_live.mp4",
                 image_key: "concerts/concert_live.png",
                 tag_label: "Live",
                 percent: progress_3000,
                 use_video: use_live_video %>

      <%= render "shared/card_concert",
                 variant: :physique,
                 season_points: @season_points,
                 target_points: 6_000,
                 video_key: "concerts/concert_physique.mp4",
                 image_key: "concerts/concert_physique.png",
                 tag_label: "Physique",
                 percent: progress_6000,
                 use_video: use_physique_video %>
    </div>

    <!-- Bloc Aujourd'hui -->
    <div class="bg-black rounded-3xl p-4 shadow-md mt-5 border border-purple-500/35">
      <h3 class="text-sm font-semibold text-white mb-2">⚡ Aujourd'hui</h3>
      <p class="text-sm text-gray-300 mb-4">
        <% if @remaining_playlists_today == :unlimited %>
          Tu es VIP : joue autant que tu veux aujourd'hui.
        <% else %>
          Tu peux lancer jusqu'à <span class="font-semibold text-purple-300">7</span> nouvelles playlists par jour.<br>
          Il te reste <span class="font-semibold text-purple-300"><%= @remaining_playlists_today %></span> playlists à jouer.
        <% end %>
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a href="<%= playlists_path %>"
           class="flex-1 inline-flex items-center justify-center px-4 py-3 text-sm font-semibold rounded-full text-white bg-purple-600 hover:bg-purple-700 transition-all shadow-lg">
          🎵 Jouer une playlist
        </a>

        <% unless @user.vip? %>
          <a href="<%= subscriptions_path %>"
             class="inline-flex items-center justify-center px-4 py-3 text-xs font-semibold rounded-full text-purple-100 bg-transparent hover:bg-purple-900/70 border border-purple-500/70 transition-all">
            Devenir VIP
          </a>
        <% end %>
      </div>
    </div>
  </div>
</div>

