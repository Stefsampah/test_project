<div class="min-h-screen bg-gray-900 py-8">
  <div class="max-w-md mx-auto px-4">
    <!-- Hero simple -->
    <div class="bg-gray-900 rounded-2xl p-4 mb-6">
      <h1 class="text-3xl font-bold text-white mb-2 text-center">
        Ton concert, ta saison
      </h1>
      <% if @season %>
        <p class="text-sm text-purple-200 text-center font-semibold">
          <%= @season.name %> • concerts à gagner • <%= @season.starts_at.to_date.strftime('%d/%m') %> – <%= @season.ends_at.to_date.strftime('%d/%m') %>
        </p>
      <% end %>
      <p class="text-sm text-purple-300 mt-3 text-center">
        Gagne des points parcours pour ton concert live et une chance pour le concert physique.
      </p>
    </div>

    <!-- Carte Concert live – fond violet avec visuel -->
    <div class="bg-gradient-to-b from-purple-800 to-purple-900 text-white rounded-3xl shadow-lg overflow-hidden mb-4 border border-purple-500/60">
      <!-- Zone image (3/4 de la carte) -->
      <div class="h-40 sm:h-48 bg-gray-200">
        <%# Remplace 'concerts/live.jpg' par le chemin réel de ton visuel (ex: app/assets/images/concerts/concert_live.png) %>
        <%= image_tag 'concerts/concert_live.png', alt: 'Concert live', class: 'w-full h-full object-cover' rescue nil %>
      </div>
      <!-- Corps -->
      <div class="p-4">
        <h2 class="text-lg font-semibold mb-1 text-purple-200">
          Concert live
        </h2>
        <p class="text-xs text-purple-200 mb-2">
          Palier à 3&nbsp;000 points cette saison.
        </p>
        <% progress_3000 = [[(@season_points.to_f / 3_000.0) * 100.0, 100].min, 0].max.round %>
        <p class="text-sm text-purple-50 mb-3">
          <% if @season_points < 3_000 %>
            Tu as <span class="font-semibold text-purple-200"><%= @season_points %> pts</span> cette saison.
            Encore <span class="font-semibold text-purple-200"><%= 3_000 - @season_points %> pts</span> pour débloquer ton lien de concert.
          <% else %>
            Tu as atteint les 3&nbsp;000 points 🎉 Ton lien de concert est débloqué.
          <% end %>
        </p>
        <div class="mb-2 flex justify-between items-center">
          <span class="text-[11px] font-semibold text-purple-100 uppercase tracking-wide">
            Progression
          </span>
          <span class="text-[11px] text-purple-100">
            <%= progress_3000 %>% de 3&nbsp;000 pts
          </span>
        </div>
        <div class="w-full h-2.5 bg-purple-950 rounded-full overflow-hidden">
          <div class="h-2.5 bg-purple-500" style="width: <%= progress_3000 %>%;">
          </div>
        </div>
      </div>
    </div>

    <!-- Carte Concert physique – fond violet foncé avec visuel -->
    <div class="bg-gradient-to-b from-purple-900 to-black text-white rounded-3xl shadow-lg overflow-hidden mb-6 border border-purple-500/60">
      <!-- Zone image (3/4 de la carte) -->
      <div class="h-40 sm:h-48 bg-gray-800">
        <%# Remplace 'concerts/concert_physique.png' par le chemin réel de ton visuel %>
        <%= image_tag 'concerts/concert_physique.png', alt: 'Concert physique', class: 'w-full h-full object-cover' rescue nil %>
      </div>
      <!-- Corps -->
      <div class="p-4">
        <h2 class="text-lg font-semibold mb-1 text-purple-200">
          Concert physique
        </h2>
        <p class="text-xs text-purple-200 mb-2">
          Palier à 6&nbsp;000 points et tirage au sort des 10 places.
        </p>
        <p class="text-sm text-purple-50 mb-3">
          <% if @season_points < 6_000 %>
            Tu as <span class="font-semibold text-purple-200"><%= @season_points %> pts</span> sur 6&nbsp;000.
            Encore <span class="font-semibold text-purple-200"><%= 6_000 - @season_points %> pts</span> pour entrer dans le tirage des 10 places de concert physique.
          <% else %>
            Tu es dans le tirage pour les 10 places de concert physique 🙌
          <% end %>
        </p>
        <div class="mb-2 flex justify-between items-center">
          <span class="text-[11px] font-semibold text-gray-300 uppercase tracking-wide">
            Progression
          </span>
          <span class="text-[11px] text-purple-100">
            <%= @progress_percent %>% de 6&nbsp;000 pts
          </span>
        </div>
        <div class="w-full h-2.5 bg-purple-950 rounded-full overflow-hidden">
          <div class="h-2.5 bg-purple-500" style="width: <%= @progress_percent %>%;">
          </div>
        </div>
      </div>
    </div>

    <!-- Bloc Aujourd'hui -->
    <div class="bg-gray-900 rounded-2xl p-4 shadow-md border border-gray-800">
      <h3 class="text-sm font-semibold text-white mb-2">
        ⚡ Aujourd'hui
      </h3>
      <p class="text-sm text-gray-300 mb-4">
        <% if @remaining_playlists_today == :unlimited %>
          Tu es VIP : tu peux jouer autant de playlists que tu veux aujourd'hui.
        <% else %>
          Tu peux lancer jusqu'à 7 nouvelles playlists par jour.<br>
          Il te reste
          <span class="font-semibold text-purple-300"><%= @remaining_playlists_today %></span>
          playlists à jouer aujourd'hui.
        <% end %>
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="<%= playlists_path %>"
           class="flex-1 inline-flex items-center justify-center px-4 py-3 text-sm font-semibold rounded-full text-white bg-purple-600 hover:bg-purple-700 transition-all shadow-lg">
          🎵 Jouer une playlist
        </a>
        <% unless @user.vip? %>
          <a href="<%= subscriptions_path %>"
             class="inline-flex items-center justify-center px-4 py-3 text-xs font-semibold rounded-full text-purple-100 bg-transparent hover:bg-purple-900/70 border border-purple-500/70 transition-all">
            Devenir VIP
          </a>
        <% end %>
      </div>
    </div>
  </div>
</div>

