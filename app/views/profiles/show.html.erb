<div class="min-h-screen bg-gradient-to-b from-[#6b21a8] to-[#1d4ed8] py-6">
  <div class="max-w-md mx-auto px-4">
    <!-- Hero -->
    <div class="rounded-3xl overflow-hidden shadow-xl" style="background: linear-gradient(180deg, #7e22ce 0%, #6b21a8 45%, #2563eb 100%);">
      <div class="p-6">
        <div class="flex flex-col items-center text-center">
          <div class="relative shrink-0">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar,
                            class: "w-24 h-24 rounded-full object-cover shadow-xl" %>
            <% else %>
              <div class="w-24 h-24 rounded-full bg-gray-900/80 flex items-center justify-center shadow-xl">
                <span class="text-white text-3xl font-bold"><%= @user.email.first.upcase %></span>
              </div>
            <% end %>

            <button onclick="document.getElementById('avatar-input').click()"
                    class="absolute -bottom-1 -right-1 bg-purple-600 hover:bg-purple-700 text-white rounded-full p-2 shadow-lg transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </button>

            <%= form_with url: profile_path, method: :patch, local: true, class: "hidden" do |f| %>
              <%= f.file_field :avatar, id: "avatar-input", accept: "image/*", onchange: "this.form.submit()" %>
            <% end %>
          </div>

          <h1 class="mt-4 text-3xl font-extrabold text-white leading-tight">
            🎯 <%= @user.username || @user.email.split('@').first %>
          </h1>
          <p class="text-sm text-white/85 mt-1">
            📧 <%= @user.email %>
          </p>
        </div>

        <!-- Stats verticales -->
        <div class="mt-6 rounded-3xl p-4" style="background: linear-gradient(180deg, rgba(126,34,206,0.95) 0%, rgba(37,99,235,0.95) 100%);">
          <div class="space-y-3 text-white">
            <div class="flex items-center justify-between">
              <span class="text-sm text-white/85"><%= t("profile.journey_points") %></span>
              <span class="text-lg font-extrabold text-amber-300"><%= @user.journey_points || 0 %></span>
            </div>
            <div class="h-px bg-white/20"></div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-white/85"><%= t("profile.games_count") %></span>
              <span class="text-lg font-extrabold text-white"><%= @user.games.count %></span>
            </div>
            <div class="h-px bg-white/20"></div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-white/85"><%= t("profile.playlists_per_day_label") %></span>
              <span class="text-lg font-extrabold text-white"><%= @user.respond_to?(:playlists_per_day) ? @user.playlists_per_day.to_f.round(1) : 0 %></span>
            </div>
            <div class="h-px bg-white/20"></div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-white/85">Watch moyen (30j)</span>
              <span class="text-lg font-extrabold text-white"><%= @watch_avg_seconds %>s</span>
            </div>
            <div class="h-px bg-white/20"></div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-white/85">Taux de completion</span>
              <span class="text-lg font-extrabold text-white"><%= @completion_rate %>%</span>
            </div>
            <div class="h-px bg-white/20"></div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-white/85">Ratio Like / Dislike</span>
              <span class="text-lg font-extrabold text-white"><%= @like_ratio_percent %>% / <%= @dislike_ratio_percent %>%</span>
            </div>
            <div class="h-px bg-white/20"></div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-white/85">Modificateur anti-abus</span>
              <span class="text-lg font-extrabold <%= @anti_abuse_modifier < 1.0 ? 'text-amber-300' : 'text-white' %>">x<%= format('%.2f', @anti_abuse_modifier) %></span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Actions entre hero et historique -->
    <div class="mt-6 mb-6 bg-black rounded-3xl p-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="<%= playlists_path %>" class="w-full app-btn-cta">
          <%= t('profile.play') %>
        </a>
        <a href="<%= scores_path %>" class="w-full app-btn-cta">
          <%= t('nav.scores') %>
        </a>
      </div>
    </div>

    <!-- Historique (bloc type leaderboard) -->
    <div class="mt-6 rounded-3xl overflow-hidden" style="background: linear-gradient(180deg, #7e22ce 0%, #2563eb 100%);">
      <div class="px-5 py-4 flex items-center justify-between">
        <div>
          <div class="text-sm font-extrabold text-white"><%= t("profile.history_title") %></div>
          <div class="text-xs text-white/60"><%= t("profile.recent_sessions") %></div>
        </div>
        <div class="px-3 py-1 rounded-full bg-black/25 text-xs font-semibold text-purple-200">
          { <%= @recent_games.size %> }
        </div>
      </div>

      <div class="p-4 space-y-3">
        <% @recent_games.each do |game| %>
          <a href="<%= playlist_game_path(game.playlist, game) %>"
             class="flex items-center gap-3 bg-black/25 rounded-2xl p-3 hover:bg-black/35 transition-all">
            <img src="<%= game.playlist.thumbnail_url %>"
                 alt="<%= game.playlist.title %>"
                 class="w-16 h-10 rounded-xl object-cover flex-shrink-0" />

            <div class="flex-1 min-w-0">
              <div class="text-white font-bold text-sm truncate"><%= game.playlist.title %></div>
              <div class="text-white/60 text-xs mt-1">
                <span class="<%= game.completed_at.present? ? 'text-amber-200' : 'text-purple-200' %> font-semibold">
                  <%= game.completed_at.present? ? t("profile.status.completed") : t("profile.status.in_progress") %>
                </span>
              </div>
            </div>

            <div class="w-10 h-10 rounded-full bg-purple-600/25 flex items-center justify-center">
              <span class="text-purple-200 text-lg">▶</span>
            </div>
          </a>
        <% end %>

        <% if @recent_games.blank? %>
          <div class="text-sm text-white/75 bg-black/25 rounded-2xl p-4">
            <%= t("profile.no_sessions_yet") %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  // Auto-submit du formulaire d'avatar
  document.getElementById('avatar-input')?.addEventListener('change', function() {
    this.form.submit();
  });
</script>