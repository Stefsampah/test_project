<div style="padding: 20px; max-width: 500px; margin: 0 auto; background-color: #333; color: white; border-radius: 10px;">
  <h2 style="text-align: center; margin-bottom: 20px;">Inscription</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { autocomplete: "off" }) do |f| %>
    <% if resource.errors.any? %>
      <div style="background-color: #f44336; color: white; padding: 10px; margin-bottom: 15px; border-radius: 5px;">
        <strong>Impossible de créer le compte :</strong>
        <ul style="margin-top: 8px; padding-left: 18px;">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 15px;">
      <%= f.label :email, "Email" %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
                         style: "width: 100%; padding: 8px; background-color: #444; color: white; border: 1px solid #555; border-radius: 4px; margin-top: 5px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "Mot de passe" %><br />
      <%= f.password_field :password, autocomplete: "new-password",
                            style: "width: 100%; padding: 8px; background-color: #444; color: white; border: 1px solid #555; border-radius: 4px; margin-top: 5px;" %>
      <% if defined?(@minimum_password_length) && @minimum_password_length %>
        <p style="font-size: 12px; color: #cbd5e1; margin-top: 6px;">
          <%= @minimum_password_length %> caractères minimum
        </p>
      <% end %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password_confirmation, "Confirmer le mot de passe" %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
                            style: "width: 100%; padding: 8px; background-color: #444; color: white; border: 1px solid #555; border-radius: 4px; margin-top: 5px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <button type="submit"
              style="width: 100%; padding: 10px; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer;">
        Créer mon compte
      </button>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 15px;">
    <%= render "devise/shared/links" %>
  </div>
</div>

