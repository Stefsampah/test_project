<div class="simplified-stats-container">
  <h2>📊 Statistiques Simplifiées</h2>
  
  <div class="stats-grid">
    <!-- Régularité -->
    <div class="stat-card regularity">
      <div class="stat-icon">🎮</div>
      <div class="stat-content">
        <h3>Régularité</h3>
        <div class="stat-value"><%= @user.playlists_per_day.round(1) %> playlists/jour</div>
        <div class="stat-points"><%= @user.regularity_points %> points</div>
        <div class="stat-progress">
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= [@user.playlists_per_day * 10, 100].min %>%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Temps d'écoute -->
    <div class="stat-card listening">
      <div class="stat-icon">⏱️</div>
      <div class="stat-content">
        <h3>Temps d'écoute</h3>
        <div class="stat-value"><%= @user.watch_time_minutes %> minutes</div>
        <div class="stat-points"><%= @user.listening_points %> points</div>
        <div class="stat-progress">
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= [@user.watch_time_minutes * 0.5, 100].min %>%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Critique constructive -->
    <div class="stat-card critical">
      <div class="stat-icon">🧠</div>
      <div class="stat-content">
        <h3>Critique constructive</h3>
        <div class="stat-value"><%= @user.likes_count %> likes, <%= @user.dislikes_count %> dislikes</div>
        <div class="stat-points"><%= @user.critical_opinions_points %> points</div>
        <div class="stat-progress">
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= [@user.critical_opinions_points * 2, 100].min %>%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Points parcours (saison) -->
    <div class="stat-card total">
      <div class="stat-icon">🏆</div>
      <div class="stat-content">
        <h3>Points parcours (saison)</h3>
        <div class="stat-value"><%= @user.season_journey_points || 0 %> points</div>
        <div class="stat-breakdown">
          <small>Progression utilisée pour les paliers concert 3000 / 6000.</small>
        </div>
      </div>
    </div>

    <!-- Points achetés -->
    <div class="stat-card purchased">
      <div class="stat-icon">💰</div>
      <div class="stat-content">
        <h3>Points achetés</h3>
        <div class="stat-value"><%= @user.purchased_points %> points</div>
        <div class="stat-breakdown">
          <small>Pour débloquer du contenu uniquement</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Badges disponibles -->
  <div class="available-badges">
    <h3>🎯 Badges Disponibles</h3>
    <div class="badges-grid">
      <% @user.obtainable_badges.each do |badge| %>
        <div class="badge-card available">
          <div class="badge-icon">🏅</div>
          <div class="badge-info">
            <h4><%= badge.name %></h4>
            <p><%= badge.description %></p>
            <div class="badge-conditions">
              <small><%= badge.conditions_description %></small>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
.simplified-stats-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}

.stat-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16px;
  padding: 24px;
  color: white;
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-4px);
}

.stat-card.regularity {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
}

.stat-card.listening {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
}

.stat-card.critical {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  color: #333;
}

.stat-card.total {
  background: linear-gradient(135deg, #ffd89b 0%, #19547b 100%);
}

.stat-card.purchased {
  background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
}

.stat-icon {
  font-size: 2.5rem;
  margin-bottom: 16px;
}

.stat-content h3 {
  margin: 0 0 8px 0;
  font-size: 1.2rem;
  font-weight: 600;
}

.stat-value {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 8px;
}

.stat-points {
  font-size: 1.1rem;
  opacity: 0.9;
  margin-bottom: 16px;
}

.stat-progress {
  margin-top: 12px;
}

.progress-bar {
  width: 100%;
  height: 8px;
  background: rgba(255,255,255,0.2);
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: rgba(255,255,255,0.8);
  transition: width 0.3s ease;
}

.available-badges {
  margin-top: 40px;
}

.available-badges h3 {
  margin-bottom: 20px;
  color: #333;
}

.badges-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 16px;
}

.badge-card {
  background: white;
  border: 2px solid #e1e5e9;
  border-radius: 12px;
  padding: 20px;
  transition: all 0.3s ease;
}

.badge-card.available {
  border-color: #4ecdc4;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.badge-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

.badge-icon {
  font-size: 2rem;
  margin-bottom: 12px;
}

.badge-info h4 {
  margin: 0 0 8px 0;
  color: #333;
  font-size: 1.1rem;
}

.badge-info p {
  margin: 0 0 12px 0;
  color: #666;
  font-size: 0.9rem;
}

.badge-conditions {
  font-size: 0.8rem;
  color: #888;
  background: #f8f9fa;
  padding: 8px;
  border-radius: 6px;
}

@media (max-width: 768px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
  
  .badges-grid {
    grid-template-columns: 1fr;
  }
}
</style>
